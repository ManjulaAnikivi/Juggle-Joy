@using juggle_joy.Models
@{
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    var userid = Convert.ToInt32(Session["UserID"]);

    var tbluser = ctx.tbl_user.Where(x => x.UserID == userid).FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>
    @Html.Partial("dashboard_css")
    <style>
        .btn_pause {
            min-width: 80px;
            min-height: 30px;
            border-radius: 20px;
            color: white;
            background: #00c1ab;
            padding: 3px 12px;
            border: none;
        }

        .btn_cancel {
            min-width: 80px;
            min-height: 30px;
            border-radius: 20px;
            color: #00c1ab;
            border: 1px solid #00c1ab;
            padding: 3px 12px;
            background: white;
        }

        .crossBtn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 20px;
            height: 20px;
            float: right;
            margin-top: -13px;
        }


        @@media(max-width: 492px) {
            .btn_pause {
                font-size: 12px;
            }

            .btn_cancel {
                font-size: 12px;
            }
        }

        @@media(max-width: 382px) {
            .btn_pause {
                font-size: 10px;
            }

            .btn_cancel {
                font-size: 10px;
            }
        }
    </style>
</head>

<body class="body-my-profile-page">
    @Html.Partial("dashboard-header")

    <main class="main my-profile-page">
        <div class="dashboard-background">

            <section class="my-profile">
                <div class="my-profile-main">
                    <div class="container">
                        <div class="content-wrapper">
                            <div class="row">
                                @Html.Partial("sidebar")
                                <div class="col-xl-9 col-lg-9 col-md-12 col-12 main-content" style=" margin: auto;  background: #f5f3f0; padding: 20px; border-radius: 5px; ">
                                    <div style="margin: auto; background: white; max-width: 487px !important; padding: 26px;">
                                        <div class="crossBtn" @*style="position:fixed; float: right;left: 413px !important; top: 101px !important;"*@>
                                            <a href="/subscription" style=" color: #d1cec6;"><i class="fa-solid fa-circle-xmark"></i></a>
                                        </div>
                                        <h3>We're so sorry to see you go! </h3>
                                        <p style="font-weight: bold; font-size: 13px;">
                                            We sincerely hope you've found joy in using Juggle Joy!Rather than cancelling,consider pausing your subscription
                                            payments.By doing so,you can rest assured that the price you initially signed up with will remain unchanged.This way,
                                            your account will remain open for whenever you're ready to return.We appreciate your support and look forward  to
                                            welcoming you back whenever you choose
                                        </p>

                                        <div style="display: flex; justify-content: space-around; margin-top: 15px; ">
                                            <button class="btn_pause" type="submit" onclick="activeSubscriptionPlan('@tbluser.SubscriptionId','pause')">Pause Subscription</button>
                                            <a href="/Confirm-cancelSubscription" class="btn_cancel">Cancel Subscription</a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    @Html.Partial("dashboard-footer")

    @Html.Partial("js")



</body>

</html>
<script>
    $("#subscription").addClass("active");


</script>

<script>
    function activeSubscriptionPlan(sid, sStatus) {
        debugger
        var subscriptionId = sid;
        var SubscriptionStatus = sStatus;

       if (SubscriptionStatus == "pause") {
            $.ajax({
                url: '/Home/PauseSubscription',
                type: 'POST',
                data: { subscriptionId: subscriptionId },
                dataType: "json",
                success: function (data) {
                    debugger
                    if (data.paused) {
                        debugger
                        
                        window.location.href = '/subscription';
                    }
                    else {
                        $("#lbl_messages").css("display", "block")
                        $("#lbl_messages").css("color", "#f35a5a");
                        $("#lbl_messages").fadeOut(5000);
                        $("#lbl_messages").html("Something went wrong");
                    }

                },
                error: function (error) {
                    console.log(error);
                    $("#lbl_messages").css("display", "block")
                    $("#lbl_messages").css("color", "#f35a5a");
                    $("#lbl_messages").fadeOut(5000);
                    $("#lbl_messages").html("Something went wrong");
                }
            });
        }
       
    };
</script>