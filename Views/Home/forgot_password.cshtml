@model juggle_joy.Models.UserForgotPasswordValidation
@{
    //ViewBag.Title = "Forgot-Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot-Password - @MvcApplication.project_name</title>

    @Html.Partial("css")

</head>
<body class="body-forgot-password-page">
    @Html.Partial("header")
    <div class="main forgot-password-page">

        <section class="banner_section forms_section">
            <div class="container-fluid half-fluid banner_left">
                <div class="container-none">
                    <div class="row">
                        <div class="col-12 col-md-6 banner_image">
                            <div class="left-half wow fadeInLeft"
                                 style="background: url('/Assets/images/login/login-banner-1.png') no-repeat center center / cover;">
                            </div>
                        </div>
                        <div class="col-12 col-md-6 banner_content forms_max_width">
                            <div class="banner_items wow fadeInRight">
                                <span class="logo-small" style="background: url(/Assets/images/logo-100x100.png) no-repeat center center / contain;"></span>
                                <h1>Forgot Password</h1>
                                <h4 class="font-caveat">Good afternoon, and Welcome!</h4>
                                <div class="page-form">
                                    <p id="lbl_msg" class="login-box-msg text-danger" style="font-size:14px !important">@ViewBag.msg</p>
                                    @using (Html.BeginForm("forgot_password", "Home", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <fieldset>
                                            <div class="form_field">
                                                <label for="forgot_password_email_address">Email Address</label>
                                                @Html.TextBoxFor(x => x.emailid, "", new { placeholder = "Email Address" })
                                                @Html.ValidationMessageFor(x => x.emailid, "", new { @class = "text-danger" })

                                            </div>
                                            <div class="form_submit">
                                                <input type="submit" value="Get Password"
                                                       class="primary-btn text-decoration-none">
                                            </div>
                                            <div class="form_bottom">
                                                <p>Not a member?</p>
                                                <a href="/login">Back to login</a>
                                            </div>
                                        </fieldset>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
    @Html.Partial("footer")

</body>
</html>
@Html.Partial("js")
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script>
        if ('@ViewBag.msg' != "") {
        $("#lbl_msg").fadeOut(5000);
        }
		else {
        $("#lbl_msg").fadeOut();
		}
</script>

