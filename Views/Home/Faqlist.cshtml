@model IEnumerable<juggle_joy.Models.tbl_faq>
@using juggle_joy.Models
@{
	Layout = null;
	db_jugglejoyEntities ctx = new db_jugglejoyEntities();
	int categoryid = ViewBag.categoryid;
	var categoryname = ctx.tbl_faq_category.Where(x => x.Faq_Cat_id == categoryid).FirstOrDefault();

}
	<ul>
		<li class="active">
			<div class="accordion">
				<h4>@categoryname.Category</h4>
				@if (Model.Count() > 0)
				{
					foreach (var items in Model)
					{
						<div class="faq_row">
							<div class="faq_title">
								<span class="faq_title-text">@items.FaqQuestion</span>
							</div>
							<div class="faq_description">
								<p>
									@Html.Raw(@items.FaqAnswer)
								</p>
							</div>
						</div>
					}
				}
				else
				{
					<div class="">
						<div class="faq_title">
							<span class="faq_title-text" style="font-size:larger">No Faqs</span>
						</div>
					</div>
				}

			</div>
		</li>
	</ul>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script>
	$(".faq_title").on("click", function (e) {
		e.preventDefault();
		var $this = $(this);
		if (!$this.hasClass("accordion-active")) {
			$(".faq_description").slideUp(400);
			$(".faq_title").removeClass("accordion-active");
			$(".faq_title").removeClass("active");
			$(".faq_title").parent().removeClass("active__row");
		}
		$this.toggleClass("accordion-active");
		$this.parent().toggleClass("active__row");
		$this.next().slideToggle();
	});
</script>