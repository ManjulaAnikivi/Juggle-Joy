<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAcyOtnk8ezCBn267zOHYmCiVlfV4I4hNI&libraries=places"></script>

<script>
    $(document).ready(function () {
        debugger
            const apiKey = 'AIzaSyAcyOtnk8ezCBn267zOHYmCiVlfV4I4hNI';

            // Initialize the Google Places Autocomplete
            const input = document.getElementById('ZipPostalCode');




            const autocomplete = new google.maps.places.Autocomplete(input, {
                /*types: ['postal_code'],*/ // Limit results to postal codes
                types: ['geocode'],
                //types: ['address'], // Limit results to geocode (addresses)
                componentRestrictions: { country: 'uk' } //it limits only to that perticular country
            });

            autocomplete.addListener('place_changed', function () {

                const place = autocomplete.getPlace();
                if (place && place.address_components) {
                    displayAddressComponents(place.address_components);
                }
            });



            function displayAddressComponents(components) {
                debugger
                let streetNumber = '';
                let streetName = '';
                let locality = '';
                let region = '';
                let state = '';
                let postaltown = '';
                components.forEach(component => {
                    debugger
                    //console.log(component.types);
                    //console.log(component.long_name);

                    if (component.types.includes("street_number")) {
                        streetNumber = component.long_name;
                    } else if (component.types.includes("route")) {
                        streetName = component.long_name;
                    } else if (component.types.includes("locality")) {
                        locality = component.long_name; // City or town
                    } else if (component.types.includes("administrative_area_level_2")) {
                        region = component.long_name; // Region or county
                    } else if (component.types.includes("administrative_area_level_1")) {
                        state = component.long_name; // State or province
                    }
                    else if (component.types.includes("postal_town")) {
                        postaltown = component.long_name; // State or province
                    }
                    else if (component.types.includes("country")) {
                        $('#CountryName').val(component.long_name); // Country
                    } else if (component.types.includes("postal_code")) {
                        $('#ZipPostalCode').val(component.long_name); // Postal code
                    }

                });

                var fullAddress = `${streetNumber} ${streetName},${postaltown} ${locality}, ${region}, ${state}`.trim();
                fullAddress = fullAddress
                    .split(',')
                    .map(part => part.trim()) // Trim each part individually to remove leading/trailing spaces
                    .filter(part => part.length > 0) // Remove empty or blank parts
                    .join(', ');

                $('#Address').val(fullAddress);
                $('#Address').css('font-size', '11px !important');
                //console.log('Full Address:', fullAddress);
            }

            // Optional: Handle keyup if you want to trigger custom logic
            $('#ZipPostalCode').on('keyup', function () {
                $('#Address').val('');
                $('#CountryName').val('');
                const postalCode = $(this).val().trim();

                addressLocation(postalCode);

            });

            function addressLocation(postalCode) {
                if (!postalCode) {
                    $('#addressInfo').html('<p>Please enter a postal code</p>');
                    return;
                }

                fetch(`https://maps.googleapis.com/maps/api/geocode/json?components=postal_code:${postalCode}&key=${apiKey}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'OK' && data.results.length > 0) {
                            const addressComponents = data.results[0].address_components;
                            displayAddressComponents(addressComponents);
                        } else if (data.status === 'ZERO_RESULTS') {
                            $('#addressInfo').html('<p>No results found for this postal code.</p>');
                        } else {
                            $('#addressInfo').html(`<p>Error: ${data.status}</p>`);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        $('#addressInfo').html('<p>Error fetching address</p>');
                    });
            }
        });

    </script>




