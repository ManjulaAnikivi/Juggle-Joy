

@using juggle_joy.Models

@{
    //ViewBag.Title = "Gift subscription";
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();
    var giftingCategory = ctx.tbl_faq_category.Where(x => x.Category.ToLower() == "gifting").FirstOrDefault();

    var tblprice = ctx.tbl_price.FirstOrDefault();

    //Three Months - Subscription

    decimal? month3_AP = tblprice.DiscountedPrice * 3;
    decimal? month3_DP = (month3_AP * 90) / 100;


    //Six Months -Subscription
    decimal? month6_AP = (tblprice.DiscountedPrice * 6);
    decimal? month6_DP = (month6_AP * 85) / 100;

    //Twelve Months - Subscription
    decimal? month12_AP = (tblprice.DiscountedPrice * 12);
    decimal? month12_DP = (month12_AP * 80) / 100;

    month3_AP = Math.Round(month3_AP.Value, 2);
    month3_DP = Math.Round(month3_DP.Value, 2);

    month6_AP = Math.Round(month6_AP.Value, 2);
    month6_DP = Math.Round(month6_DP.Value, 2);

    month12_AP = Math.Round(month12_AP.Value, 2);
    month12_DP = Math.Round(month12_DP.Value, 2);

    var userid = Convert.ToInt32(Session["UserID"]);

    var msg = ViewBag.msg;


}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gift subscription - @MvcApplication.project_name</title>
    @Html.Partial("css")
    <script src="https://js.stripe.com/v3/"></script>
    <style>
        .selected {
            border: 1px solid #00c1ab;
            background: #00C1AB33;
        }
    </style>

    <script src="https://www.google.com/recaptcha/api.js?render=@juggle_joy.Models.GlobalMethods.Google_reCAPTCHA_SiteKey"></script>
</head>
<body class="body-gift-subscription-page background-banner-video">
    @Html.Partial("header")
    <div class="main gift-subscription-page home-page">

        <Section class="gift-subscription banner">
            <!-- <div class="banner-main home-page-banner" style="background: url('./assets/images/banner.png') no-repeat center center / cover;"> -->
            <div class="banner-main home-page-banner">
                <video autoplay muted loop poster="~/Assets/images/banner" id="bgvid"
                       style="background: url('/Assets/images/banner.png') no-repeat center center / cover;">
                    <source src="~/Assets/images/sample-video.mp4" type="video/webm">
                    <source src="~/Assets/images/sample-video.mp4" type="video/mp4">
                </video>
                <div class="play-pause-btn">
                    <button class="play-pause bg-video-playing">
                        <svg class="play" width="24" height="28" viewBox="0 0 24 28" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M24 14L-1.30507e-06 27.8564L-9.36995e-08 0.143593L24 14Z" fill="white" />
                        </svg>
                        <svg class="pause" width="24" height="28" viewBox="0 0 29 40" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <line x1="1.5" x2="1.5" y2="40" stroke="white" stroke-width="8" />
                            <line x1="27.5" x2="27.5" y2="40" stroke="white" stroke-width="8" />
                        </svg>
                    </button>
                </div>
                <div class="container banner-container">
                    <div class="banner-content wow fadeInUp">
                        <h1 class="font-caveat font-size-caveat-main text-center">
                            Give the gift of family time: a JuggleJoy subscription
                        </h1>
                    </div>
                </div>
            </div>
        </Section>

        <section class="gift-subscription-section-2">
            <div class="gift-subscription-section-2-main section-position">
                <div class="container">
                    <p class="medium-p-2 text-center">
                        With JuggleJoy's membership service, you can give your loved ones the gift of time and ease. Gift them a personalised and unique present that will make their busy lives easier. Choose from one month to up to a full year’s worth of family support.

                        <br><br>
                        A JuggleJoy membership is no ordinary present. You’re providing your receivers with the essential resource of time, allowing them to savour and cherish the most important moments in life with their loved ones.
                    </p>
                </div>
                @*<div class="chat-icon" style="width: 130px;">
                        <a href="#">
                            <img src="~/Assets/images/chat-icon-1.png" alt="chat-icon">
                        </a>
                        <p class="py-1">
                            Got a question?
                            Chat to us!
                        </p>
                    </div>*@
            </div>
        </section>


        <section class="choose-gift-value">
            <div class="choose-gift-value-main">
                <div class="container">
                    <div class="row">
                        <!-- flex-column-reverse flex-md-row -->
                        <div class="col-xl-4 col-lg-4 col-md-5 col-12 content-wrapper">
                            <div class="content wow fadeInLeft">
                                <form action="" name="gift_subscription_form" id="gift_subscription_form">
                                    <input type="hidden" id="UserGoogleCaptchaToken" name="UserGoogleCaptchaToken" />

                                    <p class="content-heading">Choose Gift Value</p>
                                    <div class="subscription-plan">
                                        <p>One Month - Subscription</p>
                                        <div class="subscription-plan-box-container">
                                            <div class="subscription-plan-box" id="month1">
                                                <span class="subscription-discount font-caveat" id="D5">5% OFF</span>
                                                <span class="subscription-price-striked" id="D5AP">£@tblprice.ActualPrice</span>
                                                <span class="subscription-price" id="D5DP">£@tblprice.DiscountedPrice</span>
                                            </div>


                                            <a href="javascript:void(0)" class="subscription-buy" id="1">Buy</a>
                                        </div>
                                    </div>
                                    <div class="subscription-plan">
                                        <p>Three Months - Subscription</p>
                                        <div class="subscription-plan-box-container">
                                            <div class="subscription-plan-box" id="month3">
                                                <span class="subscription-discount font-caveat" id="D10">10% OFF</span>
                                                <span class="subscription-price-striked" id="D10AP">£@month3_AP</span>
                                                <span class="subscription-price" id="D10DP">£@month3_DP</span>
                                            </div>

                                            <a href="javascript:void(0)" class="subscription-buy" id="3"> Buy</a>
                                        </div>
                                    </div>
                                    <div class="subscription-plan">
                                        <p>Six Months - Subscription</p>
                                        <div class="subscription-plan-box-container">
                                            <div class="subscription-plan-box" id="month6">
                                                <span class="subscription-discount font-caveat" id="D15">15% OFF</span>
                                                <span class="subscription-price-striked" id="D15AP">£@month6_AP</span>
                                                <span class="subscription-price" id="D15DP">£@month6_DP</span>
                                            </div>

                                            <a href="javascript:void(0)" class="subscription-buy" id="6"> Buy</a>
                                        </div>
                                    </div>
                                    <div class="subscription-plan">
                                        <p>Twelve Months - Subscription</p>
                                        <div class="subscription-plan-box-container">
                                            <div class="subscription-plan-box" id="month12">
                                                <span class="subscription-discount font-caveat" id="D20">20% OFF</span>
                                                <span class="subscription-price-striked" id="D15AP">£@month12_AP</span>
                                                <span class="subscription-price" id="D15DP">£@month12_DP</span>
                                            </div>

                                            <a href="javascript:void(0)" class="subscription-buy" id="12">Buy</a>
                                        </div>
                                    </div>
                                    <p id="lbl_subscription" style="color: #e5756f; font-size: 18px "></p>
                                    <p class="content-heading mt-4 pt-1">Choose Delivery Method</p>
                                    <fieldset>
                                        <div class="form_checkbox">
                                            <input type="checkbox" id="subscription_email_to_recipient"
                                                   name="subscription_email" value="subscription_email_to_recipient">
                                            <label for="subscription_email_to_recipient">Email to Recipient</label>
                                        </div>
                                        <div class="form_checkbox">
                                            <input type="checkbox" id="subscription_email_to_you"
                                                   name="subscription_email" value="subscription_email_to_you">
                                            <label for="subscription_email_to_you">Email to You</label>
                                        </div>

                                        <div class="form_field">
                                            <input type="text" id="subscription_recipient_name"
                                                   name="subscription_recipient_name" placeholder="Recipient name">
                                            @*@Html.TextBoxFor(x => x.RecepientName, new { placeholder = "Recipient name" })
                                                @Html.ValidationMessageFor(x => x.RecepientName, "", new { @class = "text-danger" })*@
                                        </div>
                                        <div class="form_field">
                                            <input type="text" id="subscription_recipient_email"
                                                   name="subscription_recipient_email"
                                                   placeholder="Recipient email address">
                                            @*@Html.TextBoxFor(x => x.RecepientEmail, new { placeholder = "Recipient email address" })
                                                @Html.ValidationMessageFor(x => x.RecepientEmail, "", new { @class = "text-danger" })*@
                                        </div>
                                        <div class="form_field">
                                            <input type="text" id="subscription_buyer_name"
                                                   name="subscription_buyer_name"
                                                   placeholder="Your name (leave blank for secret gift)">
                                            @*@Html.TextBoxFor(x => x.RecepientEmail, new { placeholder = "Your name (leave blank for secret gift)" })*@
                                        </div>
                                        <div class="form_field">
                                            <input type="text" id="subscription_buyer_email"
                                                   name="subscription_buyer_email"
                                                   placeholder="Your email ">
                                        </div>
                                        @*<div class="form_field">
                                                <input type="text" id="subscription_send_date" name="subscription_send_date"
                                                       placeholder="Send date">
                                            </div>*@

                                        <div class="form_field">
                                            <textarea id="subscription_gift_message" name="subscription_gift_message"
                                                      placeholder="Personalised Gift Message&#10;(optional, max 200 characters)"></textarea>
                                            @*@Html.TextAreaFor(x => x.Message, new { placeholder = "Personalised Gift Message&#10;(optional, max 200 characters)" })*@
                                        </div>

                                        <div class="form_submit">
                                            <input type="button" value="Send" class="primary-btn send">

                                        </div>

                                    </fieldset>
                                </form>

                            </div>
                        </div>
                        <div class="col-xl-8 col-lg-8 col-md-7 col-12 image-wrapper">
                            <img src="~/Assets/images/gift-subscription.png" alt="gift-subscription" class="wow fadeInRight">
                        </div>
                    </div>
                </div>
            </div>
        </section>



        <section class="gift-subscription-faq accordions">
            <div class="gift-subscription-faq-main">
                <div class="container inner-container background-logo">
                    @if (giftingCategory != null)
                    {
                        var giftingFaq = ctx.tbl_faq.Where(x => x.Faq_categoryID == giftingCategory.Faq_Cat_id).ToList();
                        if (giftingFaq.Count() > 0)
                        {
                            <h2 class="text-center mb-0">Gifting FAQ</h2>

                        }
                        <div class="accordion faq-wrapper">

                            @foreach (var item in giftingFaq)
                            {
                                <div class="faq_row">
                                    <div class="faq_title">
                                        <span class="faq_title-text">@item.FaqQuestion</span>
                                    </div>
                                    <div class="faq_description">
                                        <p>
                                            @Html.Raw(item.FaqAnswer)
                                        </p>
                                    </div>
                                </div>
                            }

                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
    <section class="verification-popup" style="display:none;" id="DivVerification">
        <div class="verification-popup-main" style="height:280px">
            <div class="verification-popup-container">
                <div class="popup-cross-btn">
                    <button><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="logo">
                    <i class="fa fa-gifts" style="font-size: 35px; color: #00C1AB;"></i>
                </div>
                <h4>Payment is complete</h4>
                <div> A confirmation email has been sent to the email you provided with gift code.</div>
                <div class="verification-bottom-btns">
                    <button class="verify-btn primary-btn verification_btn">Send Again</button>
                </div>
            </div>
        </div>
    </section>
    @Html.Partial("footer")
</body>
</html>
