<script>

       grecaptcha.ready(function () {
           grecaptcha.execute('@juggle_joy.Models.GlobalMethods.Google_reCAPTCHA_SiteKey', { action: 'userRegister' }).then(function (token) {
               /* $("#UserGoogleCaptchaToken").html(token);*/
               $("#UserGoogleCaptchaToken").val(token);
     });
 });
