
@using juggle_joy.Models
@{
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    int userid = Convert.ToInt32(Session["UserID"]);

    var price = ctx.tbl_price.FirstOrDefault();

    var subscription = ctx.tbl_subscription.Where(x => x.UserID == userid).FirstOrDefault();

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>
    @Html.Partial("dashboard_css")
    <script src="https://js.stripe.com/v3/"></script>
</head>

<body class="body-my-profile-page">
    @Html.Partial("dashboard-header")

    <main class="main my-profile-page">
        <div class="dashboard-background" id="list">

            <section class="my-profile">
                <div class="my-profile-main">
                    <div class="container">
                        <div class="content-wrapper">
                            <div class="row">



                                @Html.Partial("sidebar")

                               
                                <div class="col-xl-9 col-lg-9 col-md-12 col-12 main-content" style=" background: #f5f3f0; padding: 20px; border-radius: 5px;">
                                    @*<div class="col-xl-6 col-lg-6 col-md-6 col-12 content-wrapper">*@
                                    <div style="margin: auto; background: white; max-width: 487px !important; padding: 26px;">
                                        <div id="preloaded">
                                            <img src="~/Assets/spinner.gif" height="100" width="100" style="display: block; margin-left: auto; margin-right: auto;" />
