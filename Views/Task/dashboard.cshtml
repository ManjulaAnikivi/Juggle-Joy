<script>
   
    $('#toDoList').keypress(function (e) {
        debugger
        var key = e.which;
        if (key == 13) // the enter key code
        {
            var text = $('#to_do_list').val();

            if (text == "") {
                $('#lbl_toDo').css('display', 'block');
                $('#lbl_toDo').css("color", "#E5756F");
                $('#lbl_toDo').css("font-size", "16px");
                $('#lbl_toDo').html("Please write your to do list");
                $("#lbl_toDo").fadeOut(5000);
                return false;
            }
            else {

                //window.location.href = '/addtask?taskTitle=' + text;

                $.ajax({
                    type: "Post",
                    url: "/Task/toDoList",
                    data: { taskTitle: text },
                    dataType: "json",
                    success: function (data) {
                        debugger
                        $('#to_do_list').val("");
                        $('#lbl_toDo').css('display', 'block');
                        $('#lbl_toDo').css("color", "#00c1ab");
                        $('#lbl_toDo').css("font-size", "16px");
                        $('#lbl_toDo').css("font-weight", "bold");
                        $('#lbl_toDo').html("Task saved as draft");
                        $('#lbl_toDo').fadeOut(5000);
                        $("#taskList").load("/Task/dashboard_tasklist", function () { });
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        //console.log("not able to");
                        // alert("failed to load questions");
                    }
                });
            }
        }

    });
</script>

