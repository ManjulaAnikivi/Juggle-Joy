<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard-@MvcApplication.project_name</title>
    <link href="~/admin_assets/css/simplePagination.min.css" rel="stylesheet" />

    @Html.Partial("dashboard_css")
    @*<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>*@


</head>

<body class="body-dashboard-page">
    @Html.Partial("dashboard-header")

    <main class="main dashboard-page">

        <div class="dashboard-display-content dashboard-popups dashboard-background">

            <section class="dashboard-title">
                <div class="dashboard-title-main">
                    <div class="container">
                        <div class="content-wrapper">
                            <h1><span id="greeting"></span>, @Session["UserName"]</h1>
                            @if (tbluser.SubscriptionStatus == (int)SubscriptionStatus.Canceled)
                            {
                                <a data-title="Your current plan is expired" class="primary-btn-dashboard add_new_task" href="/addtask" style="pointer-events:none;">
                                    <i class="fa-solid fa-plus"></i><span>
                                        Add
                                        New
                                        Task
                                    </span>
                                </a>
                            }
                            else if (tbluser.SubscriptionStatus == (int)SubscriptionStatus.Paused)
                            {
                                var subscription = ctx.tbl_subscription.Where(x => x.UserID == userid).Select(x => x.ExpirationDate).FirstOrDefault();

                                if (DateTime.Now <= subscription)
                                {
                                    <a class="primary-btn-dashboard add_new_task" href="/addtask">
                                        <i class="fa-solid fa-plus"></i><span>
                                            Add
                                            New
                                            Task
                                        </span>
                                    </a>
                                }
                                else
                                {

                                    <a data-title="Your current plan is expired" class="primary-btn-dashboard add_new_task" href="/addtask" style="pointer-events:none;">
                                        <i class="fa-solid fa-plus"></i><span>
                                            Add
                                            New
                                            Task
                                        </span>
                                    </a>
                                }
                            }
                            else
                            {
                                <a class="primary-btn-dashboard add_new_task" href="/addtask">
                                    <i class="fa-solid fa-plus"></i><span>
                                        Add
                                        New
                                        Task
                                    </span>
                                </a>
                            }

                        </div>

                        @if (tbluser.SubscriptionStatus == (int)SubscriptionStatus.Canceled)
                        {
                           <p class="subscriptionmsg" id="subscriptionmsg">
                               <i class="fa fa-check-circle-o" style="color:white;"></i> Your subscription is cancelled
                               <a href="/Home/cancelSubscription_checkout" style="color: white; margin: 0 20px; text-decoration: underline;">
                                   <span>
                                       Resume Plan
                                   </span>
                               </a>
                           </p>
                        }
                        </div>
                </div>

                @*<div class="dashboard-tabs-section-main">
                        <div class="container">
                            <p class="task-notice" id="subscription"style=" background: #FAE3E2 !important; border-color: #EFACA9 !important; display:none">
                                <i class="fa-solid fa-circle-info" style="border: #EFACA9 !important; background: #FAE3E2 !important; color: #EFACA9 !important; "></i>
                                Your subscription will expire in 3days
                                <a href="/Task/renew" class="subscription">Renew</a>
                            </p>
                        </div>
                    </div>*@
            </section>



            <section class="dashboard-tabs">
                <div class="dashboard-tabs-main">
                    <div class="container">
                        <div class="tabs-and-features">
                            <div class="task-tab-titles">
                                <ul>
                                    <li class="task-tab">
                                        <a href="/dashboard" class="tab-title active-tab"
                                           data-id="draft"><i class="fa-solid fa-lightbulb"></i><span>Draft</span></a>
                                    </li>
                                    <li class="task-tab">
                                        <a href="/pending" class="tab-title"
                                           data-id="pending">
                                            <i class="fa-solid fa-hourglass-start"></i><span>Pending</span>
                                            @if (recived > 0)
                                            {
                                                <span class="notification-count">@recived</span>

                                            }

                                        </a>
                                    </li>
                                    <li class="task-tab">
                                        <a href="/ongoing" class="tab-title"
                                           data-id="ongoing">
                                            <i class="fa-solid fa-clock"></i><span>Ongoing</span>
                                            @if (ongoing > 0)
                                            {
                                                <span class="notification-count">@ongoing</span>

                                            }

                                        </a>
                                    </li>
                                    <li class="task-tab">
                                        <a href="/completed" class="tab-title"
                                           data-id="completed">
                                            <i class="fa-solid fa-star"></i><span>Completed</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="feature-buttons">
                                <div class="feature-btn-wrapper feature-btn-filter" style=" z-index: 3 !important;">
                                    <a href="javascript:void(0)" class="feature-btn filter_by">
                                        <i class="fa-solid fa-filter"></i> Filter By
                                    </a>
                                    <div class="filter-sort filters">
                                        @if (filterbyOrdered.Count() > 0)
                                        {
                                            foreach (var item in filterbyOrdered)
                                            {
                                                if (item != null)
                                                {
                                                    var cat = ctx.tbl_category.Where(x => x.CategoryID == item).FirstOrDefault();
                                                    <a href="javascript:void(0)" onclick="fiterBy('@cat.CategoryID')">@cat.Category</a>
                                                }
                                                else
                                                {
                                                    <a href="javascript:void(0)" onclick="fiterBy('100')">Incomplete</a>
                                                }

                                            }
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0)">No records</a>
                                        }

                                        @*<a href="javascript:void(0)" onclick="fiterBy(1)">Home</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(2)">Family</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(3)">Food</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(4)">Getaway</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(5)">Health</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(6)">Wellness</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(7)">Events</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(8)">Shopping</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(9)">Vehicle</a>
                                            <a href="javascript:void(0)" onclick="fiterBy(10)">Custom</a>*@
                                    </div>
                                </div>

                                <div class="feature-btn-wrapper feature-btn-sort">
                                    <a href="javascript:void(0)" class="feature-btn sort_by">
                                        <i class="fa-solid fa-arrow-down-short-wide"></i> Sort By
                                    </a>
                                    @if (filterbyOrdered.Count() > 0)
                                    {
                                        <div class="filter-sort sorts">
                                            <a href="javascript:void(0)" onclick="sortBy('N')">New to oldest</a>
                                            <a href="javascript:void(0)" onclick="sortBy('O')">Old to newest</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="filter-sort sorts">
                                            <a href="javascript:void(0)">No records</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="dashboard-tabs-section-container">

                <section class="dashboard-tabs-section tab-active" data-id="draft">
                    <div class="dashboard-tabs-section-main">
                        <div class="container">
                            <p class="task-notice" id="lbl_msg" style="color: white; font-size: 16px !important; display: block; background: rgb(0, 193, 171); opacity: 0.7; ">
                                <i class="fa fa-check-circle-o" style="color: white;"></i> @ViewBag.draftMsg
                                <span id='pop-off' style=" position: relative; left: 82%; cursor: pointer "> <i class='fa-solid fa-circle-xmark' style="color:white;"></i></span>
                            </p>
                            <p class="task-notice">
                                <i class="fa-solid fa-circle-info"></i>This is your private space to list all the tasks weighing your mind.
                                Please note that your assistant cannot access the tasks listed here.
                                When you're ready to delegate a task, provide further details for each task and click 'Create Task'.
                            </p>
                            <div class="task-input" id="toDoList">
                                <p id="lbl_toDo" style="margin-bottom:5px"></p>
                                <span id="span_toDo">Press enter to add new task</span>
                                <input type="text" placeholder="Brain dump your to-do list here . . ." id="to_do_list">

                            </div>

                            <div class="tasks-wrapper" id="taskList">

                            </div>


                            @if (tbltasklistDraft.Count() > 10)
                            {
                                <div class="task-pagination">
                                    <div id="pagination"></div>
                                </div>
                            }

                        </div>
                    </div>
                </section>



            </div>

        </div>

        <div class="dashboard-popup-content dashboard-popups dashboard-popup-background">
            <section class="task-detail-popup message-handler">
                <div class="task-detail-popup-main">
                    <div class="popup-container">
                        <div class="task-detail-popup-wrapper">
                            <div class="popup-cross-btn">
                                <button><i class="fa-solid fa-circle-xmark"></i></button>
                            </div>

                            <div class="content-wrapper" id="task_details">


                            </div>

                        </div>
                    </div>
                </div>
            </section>

        </div>

        <div class="dashboard-new-task-popup dashboard-popups dashboard-popup-background" id="list">
            <div id="preloaded">
                <img src="~/Assets/spinner.gif" height="100" width="100" style="display: block; margin-left: auto; margin-right: auto;" />
            </div>
        </div>



    </main>


    @Html.Partial("dashboard-footer")

    @Html.Partial("js")
    @Html.Partial("dashboard-script")

    <script>

        if ('@ViewBag.draftMsg' != "")
        {
            $("#lbl_msg").css("display", "block");
            //$("#lbl_msg").fadeOut(5000);
            
            setTimeout(function () {
                $("#lbl_msg").css("display","none");
            }, 4000);
  }
else
        {
            $("#lbl_msg").css("display", "none");
    $("#lbl_msg").fadeOut();
  }

        $("#pop-off").on("click", function () {
            $("#lbl_msg").css("display", "none");
        })
    </script>
</body>
</html>
<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>


<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery-1.6.simplePagination.min.js"></script>
<script>
    $("#subscriptionmsg-off").on("click", function () {
        $("#subscriptionmsg").css("display", "none");
    })

</script>
<script>
    var counttasks;
    var categoryid;
    var subcategoryid;
    function fiterBy(id) {
        debugger
        categoryid = id;


        $.ajax({
            type: "Post",
            url: "/Task/dashboard_tasklist",
            data: { catid: id, sortby: subcategoryid },
            dataType: "html",
            success: function (data) {
                debugger
                $("#taskList").html(data);
                //alert(counttasks);
                if (counttasks < 11) {
                    $('.task-pagination').css('display', 'none');
                } else {
                    $('.task-pagination').css('display', 'flex');
                    $(".pagination-list").slice(10).hide();
                    $('#pagination').pagination({
                        items: counttasks,

                        itemsOnPage: 10,

                        onPageClick: function (pageid) {
                            $("#taskList").load("/Task/dashboard_tasklist", { id: pageid, catid: id, sortby: subcategoryid });

                        }
                    });
                }

            },
            error: function (xhr, ajaxOptions, thrownError) {
                //console.log("not able to");
                // alert("failed to load questions");
            }
        });
    };


    function sortBy(res) {
        subcategoryid = res;
        $.ajax({
            type: "Post",
            url: "/Task/dashboard_tasklist",
            data: { sortby: res, catid: categoryid },
            dataType: "html",
            success: function (data) {
                debugger
                $("#taskList").html(data);
                //alert(counttasks);
                if (counttasks < 11) {
                    $('.task-pagination').css('display', 'none');
                } else {
                    $('.task-pagination').css('display', 'flex');
                    $(".pagination-list").slice(10).hide();
                    $('#pagination').pagination({
                        items: counttasks,

                        itemsOnPage: 10,

                        onPageClick: function (pageid) {
                            $("#taskList").load("/Task/dashboard_tasklist", { id: pageid, catid: categoryid, sortby: res });

                        }
                    });
                }

            },
            error: function (xhr, ajaxOptions, thrownError) {
                //console.log("not able to");
                // alert("failed to load questions");
            }
        });
    }
</script>
