@using juggle_joy.Models

@{
    Layout = null;


    int userid = Convert.ToInt32(Session["UserID"]);

    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    var tbluser = ctx.tbl_user.Where(x => x.UserID == userid).FirstOrDefault();

    var tbltask = ctx.tbl_task.ToList();

    var tbltasklistDraft = tbltask.Where(x => x.Status == (int)TaskStatus.Draft && x.FromID == userid).OrderByDescending(x => x.TaskID).ToList();


    var recived = tbltask.Where(x => x.Status == (int)TaskStatus.Received && x.FromID == userid).ToList().Count();

    var ongoing = tbltask.Where(x => x.Status == (int)TaskStatus.Ongoing && x.FromID == userid).ToList().Count();

    //filter by
    var filterby = tbltasklistDraft.Select(x => x.CategoryID).Distinct();
    var filterbyOrdered = filterby.OrderBy(x => x).ToList();

    ////Renewal
    //var tblsubscription = ctx.tbl_subscription.Where(x => x.UserID == userid && x.GiftID==null).FirstOrDefault();
    //var currentDate = DateTime.Now.Date;

    //var diff = tblsubscription.ExpirationDate.Value.Date - currentDate;

    //var daysDiff = diff.TotalDays;


    //var DiffInt = (int)daysDiff;
}
<style>

    .light-theme a, .light-theme span {
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 20.83px !important;
        border: 1px solid var(--secondary-color) !important;
        border-radius: 4px !important;
        color: var(--primary-color) !important;
        background: #ffffff !important;
        width: 40px !important;
        height: 40px !important;
        display: inline-flex !important;
        justify-content: center !important;
        align-items: center !important;
        margin: 0 3px !important;
        box-shadow: unset !important;
        /*cursor:pointer !important;*/
    }

    .light-theme .current {
        color: #ffffff !important;
        background: var(--primary-color) !important;
        border-color: #00c1ab !important;
        box-shadow: unset !important;
    }

    .subscription {
        border: 1px solid var(--primary-color);
        border-radius: 10px;
        color: var(--white-color);
        background: var(--primary-color);
        font-size: 16px;
        font-weight: 700;
        line-height: 20.83px;
        height: 35px;
        padding: 5px 15px;
        outline: none;
        position: relative;
        left: 66%;
    }

    /* .disabled {
        pointer-events: none;
        cursor: default;
        position: relative;
    }

        .disabled:hover::after {
            content: attr(data-title);
            padding-left: 10px;
            color: black;
            position: absolute;
            transform: translateX(-50%);
            z-index: 10;
            top:100%;
