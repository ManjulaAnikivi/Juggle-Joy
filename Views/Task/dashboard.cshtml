<script>
    $(document).ready(function () {
        debugger
        var today = new Date();
        var cHour = today.getHours();

        if (cHour >= 0 && cHour < 12) {
            $('#greeting').text("Good Morning");
        }
        else if (cHour >= 12 && cHour < 18) {
            $('#greeting').text("Good Afternoon");
        }
        else if (cHour >= 18 && cHour <= 23) {
            $('#greeting').text("Good Evening");

        }

    });
</script>