            white-space:nowrap;
            padding:2px;
        }*/

    @@media (max-width: 420px) {

        .dashboard-title-main h1 {
            font-size: 34px;
        }
    }


    @@media (max-width: 390px) {

        .dashboard-title-main h1 {
            font-size: 26px;
        }
    }

    @@media (max-width: 345px) {

        .dashboard-title-main h1 {
            font-size: 24px;
        }
    }

    @@media (max-width: 320px) {

        .dashboard-title-main h1 {
            font-size: 22px;
        }
    }

    @@media (max-width: 290px) {

        .dashboard-title-main h1 {
            font-size: 20px;
        }
    }

    .subscriptionmsg {
        align-content: center;
        color: white;
        font-size: 16px !important;
        display: block;
        opacity: 0.7;
        padding-top: 20px;
        padding-bottom: 10px;
        font-size: 14px;
        font-weight: 400;
        width: fit-content;
        /* line-height: 20px;*/
        background: #e5756f;
        border: 1px solid var(--secondary-color);
        border-radius: 10px;
        padding: 14px 20px;
        margin: 0 auto 10px;
