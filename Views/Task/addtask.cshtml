@model juggle_joy.Models.TaskValidation
@using juggle_joy.Models
@{
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    //loading category
    var catlist = ctx.tbl_category.ToList();

    //loading subcategory-on page load
    var catfirstdata = ctx.tbl_category.FirstOrDefault();

    var subcatfirstdatalist = ctx.tbl_subcategory.Where(x => x.CategoryID == catfirstdata.CategoryID).ToList();

    //Address
    int userid = Convert.ToInt32(Session["UserID"]);
    var tbluser = ctx.tbl_user.Where(x => x.UserID == userid).FirstOrDefault();


    //selecting default radio buttons
    var isfirstCat = true;
    var isfirsSubtCat = true;



    //binding values
    var subcatid = Model.subcategory;

    var catid = Model.CategoryID;

    var blockOnchangeSubcat = ctx.tbl_answer.Where(x => x.TaskID == Model.TaskID).FirstOrDefault();


}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
