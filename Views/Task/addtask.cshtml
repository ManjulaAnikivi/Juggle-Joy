    @Html.Partial("dashboard_css")
    <style>
        .img-container {
            width: 200px;
            height: 100px;
            text-align: center;
            margin: 0 auto;
            vertical-align: middle;
            display: table-cell;
            border-radius: 5px;
            border: 1px solid #CCCCCC;
            cursor: pointer;
        }

            .img-container img {
                max-width: 190px;
                max-height: 95px;
                text-align: center;
                border-radius: 5px;
            }

        .show_close {
            display: block;
            border-width: 0px;
            width: 22px;
            height: 22px;
            position: relative;
            margin-left: 189px;
            margin-bottom: 95px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: -112px;
        }

        .hide_close {
            display: none;
            border-width: 0px;
            width: 20px;
            height: 20px;
            position: relative;
            margin-left: 182px;
            margin-bottom: 95px;
        }

        @@media(max-width: 767px) {
            .new-task-slide-dots {
                top: 95% !important;
            }
        }
        @@media(max-width: 610px) {
            .imageDiv {
                flex-direction: column;
                justify-content: center;
                align-items: center;
                height: 300px !important;
            }
            .respImage{
                width:50%;
            }
           
            }

        @@media(max-width: 610px) {
            .show_close {
                margin-left: 184px;
            }
        }
        @@media(max-width: 450px) {
            .show_close {
                margin-left: 157px;
            }
        }
    </style>
</head>


