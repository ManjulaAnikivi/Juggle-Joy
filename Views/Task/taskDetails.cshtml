@model juggle_joy.Models.tbl_task



@using juggle_joy.Models
@using System.Data.Entity;
@{
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    var tblcat = ctx.tbl_category.Where(x => x.CategoryID == Model.CategoryID).FirstOrDefault();


    //loading task details

    //var strid = Model.SubCategoryID.ToString();

    //var tblque = ctx.tbl_question
    //            .AsEnumerable() // Switch to LINQ to Objects
    //            .Where(x => x.SubCategoryID.Split(',').Any(z => z.Trim() == strid))
    //            .ToList();

    var catid = Model.CategoryID;
    var strid = Model.SubCategoryID.ToString();
    var tblque = ctx.tbl_question.ToList();
    if (catid == 10)
    {
        tblque = ctx.tbl_question.Where(x => x.QuestionID == 1).ToList();
    }
    else
    {
        tblque = ctx.tbl_question
               .AsEnumerable() // Switch to LINQ to Objects
               .Where(x => x.SubCategoryID.Split(',').Any(z => z.Trim() == strid))
               .ToList();
    }

    ////fetching tbl_log based on date
    //var tblLog = ctx.tbl_log.Where(x => x.TaskID == Model.TaskID).GroupBy(x => DbFunctions.TruncateTime(x.LogDate)).ToList();


    //fetching assistant data
    var tblassistant = ctx.tbl_user.Where(x => x.UserID == Model.AssistantID).FirstOrDefault();
    //user data
    var tbluser = ctx.tbl_user.Where(x => x.UserID == Model.FromID).FirstOrDefault();

    var subscription = ctx.tbl_subscription.Where(x => x.UserID == Model.FromID).Select(x => x.ExpirationDate).FirstOrDefault();

    //calaculating diff btn two dates in terms of days
    var daysDiffInt = "";
    if (Model.Deadline.HasValue)
    {
        var deadline = Model.Deadline.Value.Date;
        var currentDate = DateTime.Now.Date;

        var diff = deadline - currentDate;

        var daysDiff = diff.TotalDays;

        var DiffInt = (int)daysDiff;
        daysDiffInt = DiffInt.ToString();
    }

    int id = Convert.ToInt32(ViewBag.id);
    int adid = Convert.ToInt32(ViewBag.adid);


    //minitask

    var minitask = ctx.tbl_minitask.Where(x => x.TaskID == Model.TaskID).ToList();

    int i = 1;

    //file attachment
    var filelist = ctx.tbl_taskattachment.Where(x => x.TaskID == Model.TaskID).OrderByDescending(x => x.TaskAttachmentID).ToList();

    string ext = "";

    //recommendations

    var recommendation = ctx.tbl_recommendations.Where(x => x.TaskID == Model.TaskID && (x.MiniTaskID == 0 || x.MiniTaskID == null)).ToList();
    var recstatus = ctx.tbl_recommendations.Where(x => x.TaskID == Model.TaskID && x.TaskStatus == 1 && (x.MiniTaskID == 0 || x.MiniTaskID == null)).FirstOrDefault();


    //survey
    var surveylist = ctx.tbl_surveyQue.ToList();
    var s = 1;
    var j = 1;


    //recommendation for minitask
    //var minitaskRecommendation = ctx.tbl_recommendations.Where(x => x.TaskID == Model.TaskID && x.MiniTaskID != null).ToList();
    //var minitaskRecstatus = ctx.tbl_recommendations.Where(x => x.TaskID == Model.TaskID && x.TaskStatus == 1 && x.MiniTaskID != null).FirstOrDefault();
    var m = 1;

    var userid = Convert.ToInt32(Session["UserID"]);
}
