        $('.feedback-stars span').on('click', function () {
            debugger
            var stars = $(this).closest('.feedback-stars');
            var rating = $(this).data('value');
            var questionDiv = $(this).closest('.feedback-question');
            /*$(this).siblings('input.rating-value').val(rating);*/
            questionDiv.find('.rating-value').val(rating);
            stars.find('.star').each(function () {
                var starValue = $(this).data('value');
                if (starValue <= rating) {
                    $(this).addClass('rated');
                } else {
                    $(this).removeClass('rated');
                }
            });

            // Optionally, store or display the rating value
            //console.log("Rating for question ID " + $(this).closest('.feedback-question').data('question-id') + " is: " + rating);
        });




        $('#surveyratings').on('click', function (e) {
            e.preventDefault(); // Prevent the default form submission
            debugger
            var surveyData = {};
            $('.feedback-question').each(function () {
                var questionId = $(this).data('question-id');
                //alert(questionId);
                var rating = $(this).find('.rating-value').val();
                //alert(rating);
                surveyData[questionId] = rating;
            });

            var feedback_comments = $('#feedback-comments').val();
            var comments_surveyId = $('#feedback-comments').attr("data-surveyId");
            var TaskID =@Model.TaskID;


                $.ajax({
                    url: '/Task/survey',
                    type: 'POST',
                    data: { ratings: surveyData, feedback_comments: feedback_comments, TaskID: TaskID, comments_surveyId: comments_surveyId },
                    success: function (response) {
                        //alert('Survey submitted successfully!');
                        //console.log(response);
                        $('.dashboard-feedback').css('display', 'none');
                        $(".task-events-main").load("/task/log_Events", { id: TaskID });
                        $('.dashboard-social-share').css('display', 'block');

                    },
                    error: function (error) {
                        alert('Error submitting survey');
                        //console.log(error);
                    }
                });



        });


        function completedrecommendation() {
            $('.verification-popup').css('display', 'none');
           $(".task-events-main").load("/task/log_Events", { id: @Model.TaskID});
            $('#closetask').css('display', 'none');
            $('#addmini').css('display', 'none');
            $('#msgRecmds').text("Task completed successfully");
            $('#msgRecmds').css('color', '#00c1ab');
        }
        //minitask recommendations

        function minitaskUsernote(id) {
            debugger
            $('#minitaskRecomm_' + id).css('display', 'none');
            $('#minitaskUsernote_' + id).css('display', 'block');
            $('#minitaskUsernotebtn_' + id).addClass('toggle-active');
        };

        function Minitaskbacktooptiondetail(id) {
            debugger
            $('#minitaskUsernote_' + id).css('display', 'none');
            $('#minitaskRecomm_' + id).css('display', 'block');
        };

        function minitaskaskcompleted(id,minitaskid) {

            var label = $("#lblminioption_" + minitaskid);
                 label.text("");
                 debugger
                 var user_note = $('#user_note_'+id).val();
            var TaskID =@Model.TaskID;
                 //alert(user_note);
               $.ajax({
                   url: "/Task/minitaskuserrecommendation",
                   type: "Post",
                   data: { id: id, user_note: user_note, TaskID: TaskID },
                   dataType: "json",
                   success: function (data) {
                       //alert("success");
                       $('#minitaskmoreoption_' + minitaskid).css('display', 'none');
                       $(".minitaskproceedbtn_" + minitaskid).prop("onclick", null).off("click");
                       $(".minitasktaskcompletebtn_" + minitaskid).prop("onclick", null).off("click");
                        $(".task-events-main").load("/task/log_Events", { id: @Model.TaskID});
                       label.text("Task completed successfully");
                       setTimeout(function () {
                           label.text("");
                       }, 3000);


                       //$('.dashboard-feedback').css('display', 'block');

                   },
                   error: function (xhr, error, status) {
                       //console.log(error, status);
                       alert("fail");
                   }
                 });
        };



        function minitaskmorerecommendation(id) {
              debugger
            var label = $("#lblminioption_"+id);
              label.text("");
              var TaskID =@Model.TaskID;
              $.ajax({
                  url: "/Task/minitaskmorerecommendation",
                  type: "Post",
                  data: { TaskID: TaskID, miniTaskID: id },
                  dataType: "json",
                  success: function (data) {
                      $(".task-events-main").load("/task/log_Events", { id: @Model.TaskID});
                      label.text("Your request for more option has been accepted");
                      setTimeout(function () {
                          label.text("");
                      }, 3000);

                  },
                  error: function (xhr, error, status) {
                      //console.log(error, status);
                      label.text("Failed to accept more options");
                      setTimeout(function () {
                          label.text("");
                      }, 3000);
                  }
              });
          };
    </script>

