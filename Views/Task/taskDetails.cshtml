<style>

    .verification-popup {
        width: 100%;
        height: 100%;
        position: fixed;
        z-index: 999999;
        top: 0;
        left: 0;
        background: #d1cec680;
    }

    .verification-popup-main {
        width: 450px;
        height: 415px;
        background: #ffffff;
        border-radius: 10px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .verification-popup-container {
        padding: 40px 30px 30px;
        position: relative;
    }



        .verification-popup-container > * {
            /* display: flex; */
            /* flex-direction: column; */
            /* align-items: center; */
            text-align: center;
        }

            .verification-popup-container > * > *:not(.verification-bottom-btns) {
                max-width: 320px;
                margin: 0 auto;
            }


        .verification-popup-container .message {
            margin: 10px auto 40px;
        }

            .verification-popup-container .message p {
                font-size: 16px;
                font-weight: 400;
                line-height: 20.83px;
            }



    .verification-bottom-btns {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: 36px;
    }



    .popup-cross-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 20px;
        height: 20px;
        position: absolute;
        right: 20px;
        top: 20px;
    }

        .popup-cross-btn > * {
            border: none;
            background: none;
            padding: 0;
            color: var(--primary-text);
            border-radius: 50%;
            font-size: 20px;
            width: 20px;
            height: 20px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
        }

    .primary-btn {
        min-width: 120px;
        height: 40px;
        border: none;
        border-radius: 7px;
        font-size: 16px;
        font-weight: 700;
        color: var(--white-color);
        background: var(--primary-color);
        /* text-transform: uppercase; */
        text-decoration: none;
        text-underline-offset: 3px;
        display: inline-flex;
        justify-content: space-around;
        align-items: center;
        padding: 0 20px;
        outline: none;
    }


    .danger-btn {
        min-width: 120px;
        height: 40px;
        border: none;
        border-radius: 7px;
        font-size: 16px;
        font-weight: 700;
        color: var(--white-color);
        background: #e5756f;
        /* text-transform: uppercase; */
        text-decoration: none;
        text-underline-offset: 3px;
        display: inline-flex;
        justify-content: space-around;
        align-items: center;
        padding: 0 20px;
        outline: none;
    }

    .confirmDivBoxMain {
        height: 318px;
    }


    .dashboardfdbk {
        width: 648px;
        height: 400px;
        top: 35%;
    }

    @@media(max-width: 767px) {
        .verification-popup-main {
            width: 66%;
            height: 420px;
        }

        .confirmDivBoxMain {
            height: 318px;
        }
    }

    @@media(max-width: 578px) {
        .verification-popup-main {
            width: 60%;
            height: 90%;
        }

        .confirmDivBoxMain {
            height: 318px;
        }

        .primary-btn {
            min-width: 80px;
        }

        .danger-btn {
            min-width: 80px;
        }
    }

    @@media(max-width: 530px) {
        .verification-popup-main {
            width: 90%;
            height: 90%;
        }

        .confirmDivBoxMain {
            height: 318px;
        }
    }

    @@media(max-width: 380px) {

        .verification-popup-main {
            width: 96%;
            height: 85%;
        }

        .confirmDivBoxMain {
            height: 318px;
        }
    }
</style>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Details-@MvcApplication.project_name</title>

    <!-- Open Graph meta tags -->
    <!--<meta property="og:title" content="Juggle Joy" />
    <meta property="og:description" content="Just finished my to-do list effortlessly using JuggleJoy!" />
    <meta property="og:image" content="http://www.jugglejoy.uptindia.com/path-to-your-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">-->

    @Html.Partial("dashboard_css")
    @*<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>*@


</head>


<body class="body-dashboard-page">
    @Html.Partial("dashboard-header")

    <main class="main dashboard-page">
        <div class="dashboard-popup-content dashboard-popups dashboard-popup-background" style="display:block;">

            <section class="task-detail-popup message-handler">
                <div class="task-detail-popup-main">
                    <div class="popup-container">
                        <div class="task-detail-popup-wrapper">
                            @if (Model.Status == (int)TaskStatus.Received)
                            {
                                <div class="popup-cross-btn">
                                    <a href="/pending"><i class="fa-solid fa-circle-xmark"></i></a>
                                </div>
                            }
                            else if (Model.Status == (int)TaskStatus.Ongoing)
                            {
                                <div class="popup-cross-btn">
                                    <a href="/ongoing"><i class="fa-solid fa-circle-xmark"></i></a>
                                </div>
                            }
                            else if (Model.Status == (int)TaskStatus.Complete)
                            {
                                <div class="popup-cross-btn">
                                    <a href="/completed"><i class="fa-solid fa-circle-xmark"></i></a>
                                </div>
                            }
                            else
                            {
                                <div class="popup-cross-btn">
                                    <a href="/dashboard"><i class="fa-solid fa-circle-xmark"></i></a>
                                </div>
                            }


                            <div class="content-wrapper">

                                <div class="task-popup-content task-content">
                                    <div class="task-popup-content-left task-left">
                                        <div class="task-icon-wrapper">
                                            <div class="task-icon">
                                                @if (Model.CategoryID == null)
                                                {
                                                    <img src="~/Assets/images/logo-100x100.png" alt="categoty_image">
                                                }
                                                else
                                                {
                                                    <img src="~/Assets/Category/@tblcat.CategoryImage" alt="task-image">
                                                }

                                            </div>
                                        </div>
                                        <div class="popup-task-title">
                                            <h2>@Model.TaskTitle</h2>
                                            <div class="popup-task-title-bottom">
                                                <p class="task-bottom-info">
                                                    <span class="strong-heading">
                                                        Task in
                                                        progress:
                                                    </span>

                                                    @if (tblassistant != null)
                                                    {
                                                        <span class="text-content">
                                                            With your assistant,
                                                            @tblassistant.FirstName
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content">
                                                            Need to assign Assistant
                                                        </span>
                                                    }

                                                </p>

                                                <p class="task-bottom-info">
                                                    <span class="strong-heading">
                                                        Due
                                                        Date:
                                                    </span>
                                                    @if (@Model.Deadline.HasValue)
                                                    {

                                                        if (int.Parse(daysDiffInt) >= 9)
                                                        {
                                                            <span class="text-content" style="color: #00c1ab !important;">
                                                                @daysDiffInt days
                                                            </span>
                                                        }
                                                        else if (int.Parse(daysDiffInt) >= 4 && int.Parse(daysDiffInt) <= 8)
                                                        {
                                                            <span class="text-content" style="color: #ffce00 !important;">
                                                                @daysDiffInt days
                                                            </span>
                                                        }
                                                        else if (int.Parse(daysDiffInt) >= 0 && int.Parse(daysDiffInt) <= 3)
                                                        {
                                                            <span class="text-content" style="color: #e5756f !important;">
                                                                @daysDiffInt days
                                                            </span>
                                                        }
                                                        else if (int.Parse(daysDiffInt) == 0)
                                                        {
                                                            <span class="due-date-date" style="color: #e5756f !important;">
                                                                Expiring today
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-content" style="color: #e5756f !important;">Expired</span>
                                                        }


                                                        @*if (int.Parse(daysDiffInt) > 0)
                                                        {
                                                            <span class="text-content">
                                                                @Model.Deadline.Value.ToString("dd MMM yy") (in  @daysDiffInt
                                                                days)
                                                            </span>
                                                        }
                                                        else if (int.Parse(daysDiffInt) == 0)
                                                        {
                                                            <span class="due-date-date">
                                                                @Model.Deadline.Value.ToString("dd MMM yy") (Expiring today)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-content">Expired</span>
                                                        }*@

                                                    }
                                                    else
                                                    {
                                                        <span class="text-content" style="color: #00c1ab !important;">
                                                            No Due Date
                                                        </span>
                                                    }

                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    @*<div class="popup-task-button-wrapper task-right task-button-wrapper show-btn">

                                        @if (Model.Status == (int)TaskStatus.Draft || Model.Status == (int)TaskStatus.Received)
                                        {
                                            <div class="popup-task-btn popup-task-edit-btn">

                                                <a href="/addtask/@Model.TaskID">
                                                    <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                    <span class="text">Edit Task</span>
                                                </a>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="popup-task-btn popup-task-edit-btn" style="visibility:hidden">
                                                <a href="/addtask/@Model.TaskID">
                                                    <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                    <span class="text">Edit Task</span>
                                                </a>
                                            </div>
                                        }

                                        @if (minitask.Count() < 5)
                                        {
                                            if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Received)
                                            {
                                                <div class="popup-task-btn popup-task-add-btn" id="mini_task">
                                                    <a href="/addminitask/@Model.TaskID">
                                                        <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                                        <span class="text">Add mini-task</span>
                                                    </a>
                                                </div>
                                            }
                                        }
                                    </div>*@

                                <div class="popup-task-button-wrapper task-right task-button-wrapper show-btn">
                                    @if (recommendation.Count() > 0)
                                    {
                                        <div class="popup-task-btn toggle-actions sm-text">
                                            @if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Complete)
                                            {
                                                <button onclick="actionRequired()" id="btn_actionRequired">
                                                    <span class="text">Action Required</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                    @if (tbluser.SubscriptionStatus == (int)SubscriptionStatus.Canceled)
                                    {
                                        if (Model.Status == (int)TaskStatus.Draft || Model.Status == (int)TaskStatus.Received)
                                        {
                                            <div class="popup-task-btn popup-task-edit-btn">
                                                <a href="/addtask/@Model.TaskID" style="pointer-events:none">
                                                    <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                    <span class="text">Edit Task</span>
                                                </a>
                                            </div>
                                        }
                                        if (minitask.Count() < 5)
                                        {
                                            if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Received)
                                            {
                                                <div class="popup-task-btn popup-task-add-btn">
                                                    <a href="/addminitask/@Model.TaskID" style="pointer-events:none">
                                                        <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                                        <span class="text">Add mini-task</span>
                                                    </a>
                                                </div>
                                            }
                                        }
                                    }
                                    else if (tbluser.SubscriptionStatus == (int)SubscriptionStatus.Paused)
                                    {
                                        if (DateTime.Now <= subscription)
                                        {
                                            if (Model.Status == (int)TaskStatus.Draft || Model.Status == (int)TaskStatus.Received)
                                            {
                                                <div class="popup-task-btn popup-task-edit-btn">
                                                    <a href="/addtask/@Model.TaskID">
                                                        <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                        <span class="text">Edit Task</span>
                                                    </a>
                                                </div>
                                            }
                                            if (minitask.Count() < 5)
                                            {
                                                if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Received)
                                                {
                                                    <div class="popup-task-btn popup-task-add-btn">
                                                        <a href="/addminitask/@Model.TaskID">
                                                            <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                                            <span class="text">Add mini-task</span>
                                                        </a>
                                                    </div>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            if (Model.Status == (int)TaskStatus.Draft || Model.Status == (int)TaskStatus.Received)
                                            {
                                                <div class="popup-task-btn popup-task-edit-btn">
                                                    <a href="/addtask/@Model.TaskID" style="pointer-events:none">
                                                        <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                        <span class="text">Edit Task</span>
                                                    </a>
                                                </div>
                                            }
                                            if (minitask.Count() < 5)
                                            {
                                                if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Received)
                                                {
                                                    <div class="popup-task-btn popup-task-add-btn">
                                                        <a href="/addminitask/@Model.TaskID" style="pointer-events:none">
                                                            <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                                            <span class="text">Add mini-task</span>
                                                        </a>
                                                    </div>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        if (Model.Status == (int)TaskStatus.Draft || Model.Status == (int)TaskStatus.Received)
                                        {
                                            <div class="popup-task-btn popup-task-edit-btn">
                                                <a href="/addtask/@Model.TaskID">
                                                    <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
                                                    <span class="text">Edit Task</span>
                                                </a>
                                            </div>
                                        }
                                        if (minitask.Count() < 5)
                                        {
                                            if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Received)
                                            {
                                                <div class="popup-task-btn popup-task-add-btn" id="addmini">
                                                    <a href="/addminitask/@Model.TaskID">
                                                        <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                                        <span class="text">Add mini-task</span>
                                                    </a>
                                                </div>
                                            }
                                        }
                                    }

                                    @if (Model.Status == (int)TaskStatus.Ongoing)
                                    {
                                        <div class="popup-task-btn popup-task-add-btn " id="closetask">
                                            <a href="#" onclick="$('.closetask').css('display', 'block');">
                                                <span class="icon" style=" font-size: 20px;"><i class="fa-solid fa fa-close"></i></span>
                                                <span class="text">Close task</span>
                                            </a>
                                        </div>
                                    }
                                
                                    <h3 id="msgRecmds"></h3>
                                
                                   
                                </div>
                                </div>

                                <div class="task-popup-box-contents">
                                    <div class="row">
                                        <div class="col-lg-6 col-md-6 col-12 box-content">
                                            @if (recommendation.Count() > 0)
                                            {
                                                if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Complete)
                                                {
                                                    <div class="task-review-box-res md-text">
                                                        <div class="popup-task-review-box box-background">
                                                            <span class="task-status-status task-status status-action-required"></span>
                                                            <label id="lbloption" style="color: #00c1ab"></label>
                                                            <div class="popup-task-review-wrapper" id="items_review">
                                                                <h4>Recommended for you</h4>
                                                                
                                                                <div class="popup-task-reviws">
                                                                    @if (recstatus == null)
                                                                    {
                                                                        if (recommendation.Count() > 0)
                                                                        {
                                                                            foreach (var item in recommendation)
                                                                            {
                                                                                <div class="task-review" id="recomm_@item.RecID">
                                                                                    <button class="acc-toggle btn-text">
                                                                                        <span class="strong-heading">Option @j: </span>
                                                                                        <span class="text-content">@item.Name</span>
                                                                                        <span href="#" class="task-review-btn">
                                                                                            <i class="fa-solid fa-chevron-right"></i>
                                                                                        </span>
                                                                                    </button>
                                                                                    <div class="task-review-box-details">
                                                                                        <div class="rev-acc-inn-hd">

                                                                                            <div class="meta-data">
                                                                                                <h6 class="title">@item.Name</h6>
                                                                                                <div class="rating">
                                                                                                    <span class="label">Reviews:</span><span class="value">@item.Rating</span>
                                                                                                </div>
