<script>

    $("#taskList").load("/Task/completed_tasklist", function () { });

		$(".pagination-list").slice(10).hide();
		$('#pagination').pagination({

			items: '@completedcount',
			itemsOnPage: 10,
			onPageClick: function (pageid) {
                $("#taskList").load("/Task/completed_tasklist", { id: pageid });
			}
		});
</script>


<script>
    var counttasks;
    var categoryid;
    var subcategoryid;
    function fiterBy(id) {
        categoryid = id;

        debugger
        $.ajax({
            type: "Post",
            url: "/Task/completed_tasklist",
            data: { catid: id, sortby: subcategoryid },
            dataType: "html",
            success: function (data) {
                debugger
                $("#taskList").html(data);
                //alert(counttasks);
                if (counttasks < 11) {
                    $('.task-pagination').css('display', 'none');
                } else {
                    $('.task-pagination').css('display', 'flex');
                    $(".pagination-list").slice(10).hide();
                    $('#pagination').pagination({
                        items: counttasks,

                        itemsOnPage: 10,

                        onPageClick: function (pageid) {
                            $("#taskList").load("/Task/completed_tasklist", { id: pageid, catid: id, sortby: subcategoryid });

                        }
                    });
                }

            },
            error: function (xhr, ajaxOptions, thrownError) {
                //console.log("not able to");
                // alert("failed to load questions");
            }
        });
    };


    function sortBy(res) {
        subcategoryid = res;
        $.ajax({
            type: "Post",
            url: "/Task/completed_tasklist",
            data: { sortby: res, catid: categoryid },
            dataType: "html",
            success: function (data) {
                debugger
                $("#taskList").html(data);
                //alert(counttasks);
                if (counttasks < 11) {
                    $('.task-pagination').css('display', 'none');
                } else {
                    $('.task-pagination').css('display', 'flex');
                    $(".pagination-list").slice(10).hide();
                    $('#pagination').pagination({
                        items: counttasks,

                        itemsOnPage: 10,

                        onPageClick: function (pageid) {
                            $("#taskList").load("/Task/completed_tasklist", { id: pageid, catid: categoryid, sortby: res });

                        }
                    });
                }

            },
            error: function (xhr, ajaxOptions, thrownError) {
                //console.log("not able to");
                // alert("failed to load questions");
            }
        });
    }
</script>
<script>
    $(document).ready(function () {
        debugger
        var today = new Date();
        var cHour = today.getHours();

        if (cHour >= 0 && cHour < 12) {
            $('#greeting').text("Good Morning");
        }
        else if (cHour >= 12 && cHour < 18) {
            $('#greeting').text("Good Afternoon");
        }
        else if (cHour >= 18 && cHour <= 23) {
            $('#greeting').text("Good Evening");

        }

    });
</script>