@using juggle_joy.Models
@using System.Data.Entity;
@{
    Layout = null;

    int userid = Convert.ToInt32(Session["UserID"]);
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    var tbluser = ctx.tbl_user.Where(x => x.UserID == userid).FirstOrDefault();

    var tbltask = ctx.tbl_task.ToList();
    var pendingcount = tbltask.Where(x => x.Status == (int)TaskStatus.Received && x.FromID == userid).ToList().Count();
    var ongoingcount = tbltask.Where(x => x.Status == (int)TaskStatus.Ongoing && x.FromID == userid).ToList().Count();
    var completed= tbltask.Where(x => x.Status == (int)TaskStatus.Complete && x.FromID == userid).OrderByDescending(x => x.TaskID).ToList();
    var completedcount = completed.Count();
    //filter by
    var filterby = completed.Select(x => x.CategoryID).Distinct();
    var filterbyOrdered = filterby.OrderBy(x => x).ToList();
}
<style>

    .light-theme a, .light-theme span {
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 20.83px !important;
        border: 1px solid var(--secondary-color) !important;
        border-radius: 4px !important;
        color: var(--primary-color) !important;
        background: #ffffff !important;
        width: 40px !important;
        height: 40px !important;
        display: inline-flex !important;
        justify-content: center !important;
        align-items: center !important;
        margin: 0 3px !important;
        box-shadow: unset !important;
        /*cursor:pointer !important;*/
    }

    .light-theme .current {
        color: #ffffff !important;
        background: var(--primary-color) !important;
        border-color: #00c1ab !important;
        box-shadow: unset !important;
    }


    @@media (max-width: 420px) {

