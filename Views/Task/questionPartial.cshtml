    count =@i-1;


</script>




<script>
    $(document).ready(function () {
        // Listen for clicks on radio buttons with class 'option-radio'
        $('.option-radio').click(function () {
            debugger
            /*alert();*/
            var questionId = $(this).data('questionid');
            // Hide all textareas within the same question
            $('div[id^="textarea_' + questionId + '_"]').hide();

            // Check if the clicked radio button is associated with a textbox
            if ($(this).data('optiontype') === 'textbox') {
                // Get the target textarea ID
                var targetId = $(this).data('target');

                // Show the target textarea
                $('#' + targetId).show();
            }
        });
    });
</script>


<script>
    $(document).ready(function () {
        // Listen for clicks on checkboxes

        /*   $('input[type="checkbox"]').click(function () {*/

        $('.classcheckbox').click(function () {
            debugger
            var questionId = $(this).data('questionid');

            // Check if the clicked checkbox button is associated with a textbox
            if ($(this).data('optiontype') === 'textbox') {
                // Get the target textarea ID
                var targetId = $(this).data('target');

                if ($(this).is(':checked')) {
                    $('#' + targetId).show();
                } else {
                    $('#' + targetId).hide();
                }

            }

        });
    });
</script>



<script>
    $(document).ready(function () {
        $('.optioncheckbox').change(function () {
            debugger
            var isChecked = $(this).is(':checked');
            var questionId = $(this).data('question-id');
            var $questionGroup = $('.question-group[data-question-id="' + questionId + '"]');


            if (isChecked) {
                //disables the checkbox other than the selected one
                $questionGroup.find('.optioncheckbox').not(this).prop('checked', false);

                //clears the value of other input feilds if presents
                $questionGroup.find('.input_field').val("");


            } else {
                $questionGroup.find('.optioncheckbox').prop('checked', false);
            }
        });


        $('.input_field').focus(function () {
            debugger
            var questionId = $(this).closest('.question-group').data('question-id');
            var $questionGroup = $('.question-group[data-question-id="' + questionId + '"]');
            $questionGroup.find('.optioncheckbox').prop('checked', false);
        });

    });
</script>



<script>
    $(function () {
        debugger
        var dtToday = new Date();

        var month = dtToday.getMonth() + 1;
        var day = dtToday.getDate();
        var year = dtToday.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();

        var minDate = year + '-' + month + '-' + day;

        $('.selectpresentdate').attr('min', minDate);
    });
</script>

