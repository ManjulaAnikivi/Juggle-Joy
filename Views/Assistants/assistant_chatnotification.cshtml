
@using juggle_joy.Models
@using System.Text.RegularExpressions;
@{
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();

    var userid = Convert.ToInt32(Session["AssistantID"]);

    //var chatnotification = ctx.tbl_chat.Where(x => x.ChatreadStatus == 0 && x.FromId != userid).OrderByDescending(x => x.ChatID).ToList();
    var chatnotification = ctx.tbl_chat
    .Where(x => x.ChatreadStatus == 0 && x.FromId != userid)
    .GroupBy(x => x.TaskID)
    .Select(g => g.OrderByDescending(x => x.ChatID).FirstOrDefault())
    .ToList();

    var note5 = chatnotification.Take(5);
}


<div class="admin-header-notification">
    <div class="admin-header-notification-wrapper">
        @if (chatnotification.Count() > 0)
        {
            <span class="notification-count">@chatnotification.Count()</span>
        }

        <button class="header-notification-btn"><i class="fa-solid fa-message"></i></button>
    </div>

    <div class="admin-header-notification-notifications" style="margin-top: 1px; margin-right: 50px; top: 82% !important;">
        <ul>
            @if (note5.Count() > 0)
            {
                foreach (var item in note5)
                {
                    var tasktitle = ctx.tbl_task.Where(x => x.TaskID == item.TaskID).Select(x => x.TaskTitle).FirstOrDefault();
                    <li>
                        <a href="/assistant-specific-task/@item.TaskID">
                            New messages for <b>

                                @{
                                    string noHTML = Regex.Replace(tasktitle, @"<[^>
                                         ]+>|&nbsp;", "").Trim();
                                    string noHTMLNormalised = Regex.Replace(noHTML, @"\s{2,}", " ");
                                    if (noHTMLNormalised.Length > 10)
                                    {
                                        <span>@noHTMLNormalised.Substring(0, 10)</span><span>...</span>
                                    }
                                    else
                                    {
                                        <span>@noHTMLNormalised</span>
                                    }
                                }
                            </b>
                        </a>
                    </li>
                }



            }
        </ul>
    </div>
</div>




