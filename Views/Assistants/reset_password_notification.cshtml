
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Reset Password Notification | @MvcApplication.project_name</title>
	<style>
		.btn-self {
			background-color: #00c1ab;
			width: fit-content;
			text-align: center;
			align-self: center;
			color: white;
			font-family: 'DM Sans', sans-serif !important;
			font-weight: 700;
			font-size: 1rem;
			border-radius: 10px;
			padding: 10px 30px;
		}

		.btn:hover {
			background-color: #00c1ab !important;
			color: white !important;
		}

		.title {
			text-align: center !important;
		}
	</style>
</head>
<body class="body-login-page">
	<div class="main login-page">
		<section class="banner_section forms_section">
			<div class="container-fluid half-fluid banner_left">
				<div class="container-none">
					<div class="row">
						<div class="col-12 col-md-12 banner_content forms_max_width" style="margin-top:35px;margin-bottom:35px">
							<div class="banner_items" style="width:unset !important">
								@if (ViewBag.msg == "Reset password successfully")
								{
									<h4 class="title"><i class="fa fa-check-circle" style="font-size:24px;"></i> Your existing password is reset with the new password successfully</h4><br />
									<a href="/assistant-login" class="btn secondry-btn btn-self">Go to Login Page</a>
								}
								else
								{

									<h4 class="title"> <i class="fa fa-warning" style="font-size:24px;"></i> The reset link you clicked has expired. Please request a new one.</h4><br />
									<a href="/assistant-forgot-password" class="btn btn-self">Request Password</a>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
</body>
</html>



