@model juggle_joy.Models.tbl_task
@using juggle_joy.Models
@using System.Data.Entity;

@{
    Layout = null;
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();
    var tbluser = ctx.tbl_user.ToList();
    var assist_name = tbluser.Where(x => x.UserID == Model.AssistantID).FirstOrDefault();
    var user = tbluser.Where(x => x.UserID == Model.FromID).FirstOrDefault();

    var Category = ctx.tbl_category.ToList();
    var category = Category.Where(x => x.CategoryID == Model.CategoryID).FirstOrDefault();
    var tblcat = Category.Where(x => x.CategoryID == Model.CategoryID).FirstOrDefault();

    //var handler = tbluser.Where(x => x.Status == (int)UserStatus.Active).ToList();
    //var hanlderName = tbluser.Where(x => x.UserID == Model.ToID).FirstOrDefault();
    var answerlist = ctx.tbl_answer.Include("tbl_question").Where(x => x.TaskID == Model.TaskID).ToList();

    //calaculating diff btn two dates in terms of days
    var daysDiffInt = "";
    //int daysDiffint = 0;
    var DiffInt = 0;
    if (Model.Deadline.HasValue)
    {
        var deadline = Model.Deadline.Value.Date;
        var currentDate = DateTime.Now.Date;

        var diff = deadline - currentDate;
        var daysDiff = diff.TotalDays;
        DiffInt = (int)daysDiff;
        daysDiffInt = DiffInt.ToString();



        //var difference = deadline - currentDate;
        //var daysDifference = difference.TotalDays;
        //var diffInt = (int)daysDifference;
        //daysDiffint = DiffInt;
    }

    //loading task details
    //var strid = Model.SubCategoryID.ToString();

    //var tblque = ctx.tbl_question
    //			.AsEnumerable() // Switch to LINQ to Objects
    //			.Where(x => x.SubCategoryID.Split(',').Any(z => z.Trim() == strid))
    //			.ToList();
    var catid = Model.CategoryID;
    var strid = Model.SubCategoryID.ToString();
    var tblque = ctx.tbl_question.ToList();
    if (catid == 10)
    {
        tblque = ctx.tbl_question.Where(x => x.QuestionID == 1).ToList();
    }
    else
    {
        tblque = ctx.tbl_question
               .AsEnumerable() // Switch to LINQ to Objects
               .Where(x => x.SubCategoryID.Split(',').Any(z => z.Trim() == strid))
               .ToList();
    }



    //minitask

    var minitask = ctx.tbl_minitask.Where(x => x.TaskID == Model.TaskID).ToList();
    int i = 1;

    int id = Convert.ToInt32(ViewBag.id);
    int adid = Convert.ToInt32(ViewBag.adid);

    var filelist = ctx.tbl_taskattachment.Where(x => x.TaskID == Model.TaskID).OrderByDescending(x => x.TaskAttachmentID).ToList();

    string ext = "";
    var step1 = ViewBag.step1;


    int j;
    int k = 1;
    int r = 1;
    int q = 1;
    var p = 1;
    var h = 1;




    var recommendations = ctx.tbl_recommendations.Where(x => x.TaskID == Model.TaskID && (x.MiniTaskID == null || x.MiniTaskID == 0)).ToList();

    //var button = "";
    var userid = Convert.ToInt32(Session["AssistantID"]);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>
    @Html.Partial("assistantHandler_css")

    <style>
        .bttn {
            min-width: 70px;
            height: 30px;
            border: 1px solid var(--primary-color);
            border-radius: 5px;
            font-size: 16px;
            font-weight: 700;
            line-height: 20.83px;
            color: var(--white-color);
            background: var(--primary-color);
            text-transform: uppercase;
            text-decoration: none;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            /*	padding: 0px 15px;
            padding-top: 2px;*/
            outline: none;
            gap: 5px;
        }

        .primary-btn {
            min-width: 120px;
            height: 40px;
            border: none;
            border-radius: 7px;
            font-size: 16px;
            font-weight: 700;
            color: var(--white-color);
            background: var(--primary-color);
            /* text-transform: uppercase; */
            text-decoration: none;
            text-underline-offset: 3px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            padding: 0 20px;
            outline: none;
        }

        .message-bubble-send .message-bubble-wrapper {
            justify-content: end;
        }

        .task-review {
            border-color: #ffffff !important;
        }

            .task-review:focus {
                outline: unset !important;
                border-color: #00c1ab !important;
            }

        .form_control p {
            font-weight: 600;
        }

        .bold-font {
            font-weight: bold;
        }



        .mini-task-box-toggles {
            border: none;
            color: var(--white-color);
            background: var(--primary-color);
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            font-size: 12px;
            padding: 0;
            position: absolute;
            top: 10px;
            right: 20px;
        }

        .active__row .mini-task-box-toggles {
            transform: rotateZ(90deg);
            transition: all 0.2s ease-in;
        }

        .mini-task-box-toggles {
            right: 10px;
        }



        .mini-task-journal-tab-title {
            font-size: 14px;
            font-weight: 700;
            line-height: 18px;
            color: var(--tertiary-color);
            padding-bottom: 8px;
        }


            .mini-task-journal-tab-title.active-tab {
                color: var(--primary-color);
            }

                .mini-task-journal-tab-title.active-tab::after {
                    height: 3px;
                    bottom: -3px;
                    left: 0;
                }

        .mini-task-journal-tab-title {
            font-size: 14px;
        }
      
    </style>
    <style>
        .message-view-box {
            max-height: 56vh;
            overflow-y: auto;
            padding: 0 20px 10px;
        }

            .message-view-box::-webkit-scrollbar {
                background: #00C1AB;
                width: 5px;
                height: auto;
            }

            .message-view-box::-webkit-scrollbar-thumb:hover {
                background: #00c1abb3;
            }

            .message-view-box::-webkit-scrollbar-track {
                background: #e7e7e7;
            }
        .popup-task-details::-webkit-scrollbar-track,
        .popup-tabs-container .popup-tabs-section:not(.message-handler-main)::-webkit-scrollbar-track,
        .popup-tabs-container .message-handler-main .message-view-box::-webkit-scrollbar-track {
            background: #e7e7e7;
        }

        .popup-task-details::-webkit-scrollbar-thumb,
        .popup-tabs-container .popup-tabs-section:not(.message-handler-main)::-webkit-scrollbar-thumb,
        .popup-tabs-container .message-handler-main .message-view-box::-webkit-scrollbar-thumb {
            background: #00c1ab4d;
            border-radius: 10px;
        }

            .popup-task-details::-webkit-scrollbar-thumb:hover,
            .popup-tabs-container .popup-tabs-section:not(.message-handler-main)::-webkit-scrollbar-thumb:hover,
            .popup-tabs-container .message-handler-main .message-view-box::-webkit-scrollbar-thumb:hover {
                background: #00c1abb3;
            }


        .popup-tabs-container .popup-tabs-section:not(.message-handler-main) {
            /* position: sticky; */
            min-height: 50vh;
            max-height: 90vh;
            overflow-y: auto;
            /* top: 60px; */
        }

        .popup-tabs-container .message-handler-main .message-view-box {
            /* position: sticky; */
            min-height: 50vh;
            max-height: 88vh;
            overflow-y: auto;
            /* top: 60px; */
            padding: 0 20px 10px;
        }

        .message-handler-main-wrapper {
            border: 1px solid #D1CEC6;
            border-radius: 20px;
            padding: 15px 0 0;
        }

        .popup-task-details {
            height: 60vh;
            overflow-y: auto;
            border-top: 1px solid #D1CEC6;
        }


        .message-view-box {
            /* min-height: 50vw;
    max-height: 66vw;
    overflow-y: auto;
    display: inline-grid; */
        }

        .message-view-wrapper {
            display: flex;
            flex-direction: column;
            justify-content: end;
            height: 100%;
            min-height: 50vh;
        }














        .message-bubble {
            position: relative;
            margin-top: 5px;
        }

            .message-bubble.viewbox-last-message {
                margin-top: 0;
            }

                .message-bubble.viewbox-last-message .chat-message {
                    background: #D1CEC6;
                }

        .message-bubble-wrapper {
            display: flex;
            gap: 10px;
            padding-top: 5px;
        }

        .message-avatar {
            display: inline-block;
            border-radius: 50%;
            cursor: pointer;
        }

            .message-avatar > * {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                color: var(--white-color);
                font-size: 16px;
                font-weight: 700;
                line-height: 20.83px;
                object-fit: contain;
            }

        .receive-avatar.message-avatar > * {
            background: var(--fade-red);
        }

        .send-avatar.message-avatar > * {
            background: var(--primary-color);
        }


        .chat-message {
            font-size: 16px;
            font-weight: 400;
            line-height: 26px;
            text-align: left;
            color: var(--primary-text);
            background: #F2F3EE;
            border-radius: 10px;
            padding: 10px 20px;
        }

        .message-bubble-receive.chat-message {
            justify-content: start;
        }

        .message-bubble-send .message-bubble-wrapper {
            justify-content: end;
        }

        .chat-time {
            display: block;
            font-size: 14px;
            font-weight: 400;
            line-height: 18.23px;
            color: var(--tertiary-color);
            margin-top: 5px;
        }

        .receive-time.chat-time {
            text-align: right;
        }

        .send.chat-time {
            text-align: left;
        }

        .receive-time.chat-time {
            text-align: left;
        }

        .send-time.chat-time {
            text-align: right;
        }

        span.new-receive-alert {
            font-size: 14px;
            font-weight: 400;
            line-height: 18.23px;
            text-align: left;
            color: var(--fade-red);
        }



        .type-message-main {
            background: #FAFAF9;
            padding: 20px;
            border-radius: 0 0 20px 20px;
        }

        .type-message-container {
            width: 100%;
            min-height: 50px;
            border: 1px solid var(--secondary-color);
            border-radius: 10px;
            padding: 2px 20px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .type_message {
            border: none;
            width: 100%;
            /* height: 30px; */
            font-size: 16px;
            font-weight: 400;
            line-height: 26px;
            color: var(--primary-text);
            padding: 0;
            outline: none;
            resize: none;
        }

            .type_message::placeholder {
                color: #BBBBBB;
            }

        .file-input-wrapper {
            display: inline-flex;
            position: relative;
            font-size: 16px;
            color: var(--tertiary-color);
        }

        .file_attachment {
            position: absolute;
            width: 14px;
            height: 16px;
            left: 0;
            top: 0;
            opacity: 0;
        }

        .message-submit {
            font-size: 20px;
            line-height: 26px;
            color: var(--primary-color);
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            outline: none;
        }
    </style>
</head>

<body class="body-assistant-specific-task-page body-admin-pages">
    @Html.Partial("assistantheader")
    <main class="main assistant-specific-task-page">
        <section class="admin-handler-dashboard-section">
            <div class="admin-handler-dashboard-main">
                <div class="container-fluid">
                    <div class="grid admin-page-grid">
                        @Html.Partial("assistantsidebar")
                        <div class="admin-page-task-content background-panel-color">
                            <div class="admin-page-task-content-main">
                                <div class="form_submit" style="text-align:right;margin-bottom:10px">
                                    <button type="submit" value="Go back" onclick="" class="bttn" id="reloadBackButton"><i class="fa fa-arrow-left" aria-hidden="true" style="font-size:26px"></i></button>
                                </div>
                                <div class="admin-page-task-content-container">

                                    <div class="dashboard-popup-content dashboard-popups dashboard-popup-background">
                                        <section class="task-detail-popup message-handler">
                                            <div class="task-detail-popup-main">
                                                <div class="popup-container">
                                                    <div class="task-detail-popup-wrapper">
                                                        <div class="content-wrapper">

                                                            <div class="task-popup-box-contents">
                                                                <div class="row">

                                                                    <div class="col-lg-9 col-md-8 col-12 tab-content">
                                                                        <div class="popup-tabs">

                                                                            <div class="popup-task-tab-titles">
                                                                                <ul>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title active-tab"
                                                                                           data-id="task-details">
                                                                                            <i class="fa-solid fa-comment-dots"></i><span>
                                                                                                Task
                                                                                                Details
                                                                                            </span>
                                                                                            <!-- <span
                                                                                            class="notification-count">3</span> -->
                                                                                        </a>
                                                                                    </li>
                                                                                    @if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Complete)
                                                                                    {
                                                                                        <li class="popup-task-tab">
                                                                                            <a href="javascript:void(0)"
                                                                                               class="popup-tab-title task_journal"
                                                                                               data-id="task-journal">
                                                                                                <i class="fa-solid fa-pen-to-square"></i><span>
                                                                                                    Messenger
                                                                                                </span>
                                                                                            </a>
                                                                                        </li>

                                                                                        @*<li class="popup-task-tab">
                                                                                                <a href="javascript:void(0)"
                                                                                                   class="popup-tab-title"
                                                                                                   data-id="message-handler">
                                                                                                    <i class="fa-solid fa-comment-dots"></i><span>
                                                                                                        Chat
                                                                                                    </span><span class="notification-count" id="chatcount"></span>
                                                                                                </a>
                                                                                            </li>*@
                                                                                    }
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="view-mini-task">
                                                                                            <i class="fa-solid fa-eye"></i><span>

                                                                                                Mini-task
                                                                                            </span>
                                                                                        </a>
                                                                                    </li>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="attachment">
                                                                                            <i class="fa-solid fa-paperclip"></i><span>Attachment</span>
                                                                                        </a>
                                                                                    </li>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="task-events">
                                                                                            <i class="fa-solid fa-calendar-days"></i><span>

                                                                                                Events
                                                                                            </span>
                                                                                        </a>
                                                                                    </li>
                                                                                </ul>
                                                                            </div>

                                                                            <div class="popup-tabs-container">

                                                                                <div class="popup-tabs-section tab-active"
                                                                                     data-id="task-details">

                                                                                    <div class="task-popup-content task-content">
                                                                                        <div class="task-popup-content-left task-left">
                                                                                            <div class="task-icon-wrapper">
                                                                                                <div class="task-icon">
                                                                                                    <img src="~/Assets/Category/@tblcat.CategoryImage"
                                                                                                         alt="task-cake">
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="popup-task-title">
                                                                                                <h2>
                                                                                                    @Model.TaskTitle
                                                                                                </h2>
                                                                                                <div class="popup-task-title-bottom">
                                                                                                    <p class="task-bottom-info">
                                                                                                        <span class="strong-heading">
                                                                                                            Task
                                                                                                            status:
                                                                                                        </span>
                                                                                                        @if (Model.Status == (int)TaskStatus.Received)
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                New task
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (Model.Status == (int)TaskStatus.Ongoing)
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                Ongoing
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (Model.Status == (int)TaskStatus.Complete)
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                Completed
                                                                                                            </span>
                                                                                                        }
                                                                                                    </p>
                                                                                                    <p class="task-bottom-info">
                                                                                                        <span class="strong-heading">
                                                                                                            Task
                                                                                                            in
                                                                                                            progress:
                                                                                                        </span>
                                                                                                        @if (Model.AssistantID != null)
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                With
                                                                                                                your
                                                                                                                assistant,
                                                                                                                @assist_name.FirstName
                                                                                                            </span>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                Assistant not assigned
                                                                                                            </span>
                                                                                                        }

                                                                                                    </p>

                                                                                                    <p class="task-bottom-info">
                                                                                                        <span class="strong-heading">
                                                                                                            Due
                                                                                                            Date:
                                                                                                        </span>
                                                                                                        @if (@Model.Deadline.HasValue)
                                                                                                        {
                                                                                                            if (DiffInt > 0)
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    @Model.Deadline.Value.ToString("dd MMM yy") (in  @daysDiffInt
                                                                                                                    days)
                                                                                                                </span>
                                                                                                            }
                                                                                                            else if (DiffInt == 0)
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    @Model.Deadline.Value.ToString("dd MMM yy") (Expiring today)
                                                                                                                </span>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    Expired
                                                                                                                </span>
                                                                                                            }

                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                No Due Date
                                                                                                            </span>
                                                                                                        }
                                                                                                    </p>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="box-content">


                                                                                        <div class="popup-task-details-box box-background">
                                                                                            <div class="popup-task-details-wrapper ">
                                                                                                <h4>Task details</h4>



                                                                                                @foreach (var item in tblque)
                                                                                                {
                                                                                                    var ans = ctx.tbl_answer.Where(x => x.TaskID == Model.TaskID && x.QuestionID == item.QuestionID && x.MinitaskID == null).FirstOrDefault();

                                                                                                    <div class="task-details">
                                                                                                        <h6>@item.Question</h6>
                                                                                                        @if (ans != null)
                                                                                                        {

                                                                                                            if (item.OptionType == "Radio")
                                                                                                            {
                                                                                                                var tblopt = ctx.tbl_options.Where(x => x.OptionID.ToString() == ans.Answer).FirstOrDefault();
                                                                                                                if (tblopt != null)
                                                                                                                {
                                                                                                                    if (tblopt.OptionType == "textbox")
                                                                                                                    {
                                                                                                                        <p>
                                                                                                                            @tblopt.Question,@ans.OtherAnswer
                                                                                                                        </p>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <p>
                                                                                                                            @tblopt.Question
                                                                                                                        </p>
                                                                                                                    }
                                                                                                                }
                                                                                                            }
                                                                                                            else if (item.OptionType == "CheckBox")
                                                                                                            {
                                                                                                                var anslist = ctx.tbl_answer.Where(x => x.TaskID == Model.TaskID && x.QuestionID == item.QuestionID && x.MinitaskID == null).ToList();
                                                                                                                foreach (var anwser in anslist)
                                                                                                                {
                                                                                                                    var tblopt = ctx.tbl_options.Where(x => x.OptionID.ToString() == anwser.Answer).FirstOrDefault();
                                                                                                                    if (tblopt != null)
                                                                                                                    {
                                                                                                                        if (tblopt.OptionType == "textbox")
                                                                                                                        {
                                                                                                                            <p>
                                                                                                                                @tblopt.Question,@anwser.OtherAnswer
                                                                                                                            </p>
                                                                                                                        }
                                                                                                                        else
                                                                                                                        {
                                                                                                                            <p>
                                                                                                                                @tblopt.Question
                                                                                                                            </p>
                                                                                                                        }
                                                                                                                    }
                                                                                                                }
                                                                                                            }
                                                                                                            else if (item.OptionType == "Option")
                                                                                                            {
                                                                                                                var anslist = ctx.tbl_answer.Where(x => x.TaskID == Model.TaskID && x.QuestionID == item.QuestionID && x.MinitaskID == null).ToList();

                                                                                                                foreach (var anwser in anslist)
                                                                                                                {
                                                                                                                    var tblopt = ctx.tbl_options.Where(x => x.OptionID.ToString() == anwser.Answer).FirstOrDefault();
                                                                                                                    if (tblopt != null)
                                                                                                                    {
                                                                                                                        if (tblopt.OptionType == "text" || tblopt.OptionType == "counter" || tblopt.OptionType == "date" || tblopt.OptionType == "time" || tblopt.OptionType == "textarea")
                                                                                                                        {
                                                                                                                            <p>
                                                                                                                                @tblopt.Question:@anwser.OtherAnswer
                                                                                                                            </p>
                                                                                                                        }

                                                                                                                        if (tblopt.OptionType == "checkbox")
                                                                                                                        {
                                                                                                                            if (@anwser.OtherAnswer != null)
                                                                                                                            {
                                                                                                                                <p>
                                                                                                                                    @tblopt.Question:checked
                                                                                                                                </p>
                                                                                                                            }

                                                                                                                        }

                                                                                                                        if (tblopt.OptionType == "radio")
                                                                                                                        {
                                                                                                                            var opttypeid = Convert.ToInt32(anwser.OtherAnswer);
                                                                                                                            var opttypa = ctx.tbl_optiontype.Where(x => x.OptionTypeID == opttypeid).FirstOrDefault();
                                                                                                                            <p>
                                                                                                                                @tblopt.Question:@opttypa.Question
                                                                                                                            </p>
                                                                                                                        }



                                                                                                                        if (tblopt.OptionType == "ddtime")
                                                                                                                        {
                                                                                                                            var opttypeid = Convert.ToInt32(anwser.OtherAnswer);
                                                                                                                            var opttypa = ctx.tbl_optiontype.Where(x => x.OptionTypeID == opttypeid).FirstOrDefault();
                                                                                                                            <p>
                                                                                                                                @tblopt.Question:@opttypa.Question
                                                                                                                            </p>
                                                                                                                        }

                                                                                                                    }
                                                                                                                }

                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                //for counter and textarea
                                                                                                                <p>
                                                                                                                    @ans.Answer
                                                                                                                </p>
                                                                                                            }
                                                                                                        }

                                                                                                    </div>
                                                                                                }

                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
