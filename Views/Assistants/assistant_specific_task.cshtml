			// Function to refresh the previous page
			function refreshPreviousPage() {
				// Listen for the pageshow event
				$(window).on('pageshow', function (event) {
					// Check if the event's persisted property is false, indicating that the page is being loaded fresh
					if (event.originalEvent.persisted) {
						// Refresh the page
						location.reload();
					}
				});
			}

			// Function to go back in the browser history and refresh the previous page
			function goBackAndRefresh() {
				// Go back one page in the browser history
				window.history.back();

				// Call the function to refresh the previous page after a short delay (adjust as needed)
				setTimeout(refreshPreviousPage, 500); // 500 milliseconds delay, adjust as needed
			}

			// Example: Reload previous page when a button with id "reloadBackButton" is clicked
			$('#reloadBackButton').on('click', function () {
				goBackAndRefresh();
			});
		});


