@model juggle_joy.Models.AssistantResetPasswordValidation
@{
	ViewBag.Title = "Reset-Password";
}
<div class="main new-password-page">

	<section class="banner_section forms_section">
		<div class="container-fluid half-fluid banner_left">
			<div class="container-none">
				<div class="row">
					<div class="col-12 col-md-6 banner_image">
						<div class="left-half"
							 style="background: url('/Assets/images/login/login-banner-1.png') no-repeat center center / cover;">
						</div>
					</div>
					<div class="col-12 col-md-6 banner_content forms_max_width">
						<div class="banner_items">
							<span class="logo-small"
								  style="background: url(/Assets/images/logo-100x100.png) no-repeat center center / contain;"></span>
							<h1>Create New Password</h1>
							<h4 class="font-caveat">Good afternoon, and Welcome!</h4>
							<div class="page-form">
								<p id="lbl_msg" class="login-box-msg text-danger" style="font-size:16px !important">@ViewBag.msg</p>

								@using (Html.BeginForm("ResetPassword", "Assistants", FormMethod.Post))
								{
									@Html.AntiForgeryToken()
									<form action="#" id="new_password_form" name="new_password_form">
										<fieldset>
											<div class="form_field">
												<label for="NewPassword">New Password</label>
												@Html.PasswordFor(x => x.NewPassword, new { placeholder = "New Password" })
												@Html.ValidationMessageFor(x => x.NewPassword, "", new { @class = "text-danger" })
											</div>
											<div class="form_field">
												<label for="ConfirmNewPassword">Confirm Password</label>
												@Html.PasswordFor(x => x.ConfirmNewPassword, new { placeholder = "Confirm Password" })
												@Html.ValidationMessageFor(x => x.ConfirmNewPassword, "", new { @class = "text-danger" })
											</div>

											<div class="form_submit">
												<input type="hidden" name="RetUrl" value='@ViewBag.RetUrl' />
												@Html.HiddenFor(x => x.ResetCode)
												<input type="submit" value="Create New Password"
													   class="primary-btn text-decoration-none">
											</div>
											<div class="form_bottom">
												<p>Not a member?</p>
												<a href="/assistant-login">Login Here</a>
											</div>
										</fieldset>
									</form>
								}

							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	@Html.Partial("js")

</div>
<script>
        if ('@ViewBag.msg' != "") {
        $("#lbl_msg").fadeOut(5000);
    }
    else {
        $("#lbl_msg").fadeOut();
    }
</script>
