
@using juggle_joy.Models
@{
    db_jugglejoyEntities ctx = new db_jugglejoyEntities();
    Layout = null;
    var tbl_user = ctx.tbl_user.ToList();
    var task = ctx.tbl_task.FirstOrDefault();
    var asstID = Convert.ToInt32(Session["AssistantID"]);
    var tbl_task = ctx.tbl_task.ToList();

    var pending = tbl_task.Where(x => x.Status == (int)TaskStatus.Received).ToList();
    var ongoing = tbl_task.Where(x => x.AssistantID == asstID && x.Status == (int)TaskStatus.Ongoing).ToList();
    var completed = tbl_task.Where(x => x.AssistantID == asstID && x.Status == (int)TaskStatus.Complete).ToList();
    int i = 1;
}
<style>

    .light-theme a, .light-theme span {
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 20.83px !important;
        border: 1px solid var(--secondary-color) !important;
        border-radius: 4px !important;
        color: var(--primary-color) !important;
        background: #ffffff !important;
        width: 40px !important;
        height: 40px !important;
        display: inline-flex !important;
        justify-content: center !important;
        align-items: center !important;
        margin: 0 3px !important;
        box-shadow: unset !important;
        /*cursor:pointer !important;*/
    }

    .light-theme .current {
        color: #ffffff !important;
        background: var(--primary-color) !important;
        border-color: #00c1ab !important;
        box-shadow: unset !important;
    }

    .last-item {
        margin-left: auto;
        margin-right: 20px;
    }

    .tab {
        display: flex;
        align-items: center;
        gap: 20px;
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        background: var(--white-color);
        border: 1px solid var(--secondary-color);
        border-radius: 10px;
        padding: 14px 20px;
        margin-bottom: 20px;
    }
</style>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>
    @Html.Partial("assistantHandler_css")
    <link href="~/admin_assets/css/simplePagination.min.css" rel="stylesheet" />

</head>

<body class="body-admin-handler-dashboard-page body-admin-pages">
    @Html.Partial("Assistantheader")

    <main class="main admin-handler-dashboard-page">


        <section class="admin-handler-dashboard-section">
            <div class="admin-handler-dashboard-main">
                <div class="container-fluid">
                    <div class="grid admin-page-grid">
                        @Html.Partial("assistantsidebar")
                        <div class="col-lg-12 col-md-12 col-12 tab-content">
                            <div class="dashboard-popup-content dashboard-popups dashboard-popup-background">
                                <section class="task-detail-popup message-handler">
                                    <div class="task-detail-popup-main">
                                        <div class="popup-container">
                                            <div class="task-detail-popup-wrapper">
                                                <div class="content-wrapper">
                                                    <div class="task-popup-box-contents">
                                                        <div class="popup-tabs">

                                                            <div class="popup-task-tab-titles">
                                                                <ul style="gap: 20px !important; justify-content: center; color: black; padding-top: 8px">
                                                                    <li class="popup-task-tab">
                                                                        <a href="/new-tasks"
                                                                           class="popup-tab-title"
                                                                           data-id="task-details">
                                                                            <i class="fa-solid fa-hourglass-start"></i><span>
                                                                                New Tasks
                                                                            </span>
                                                                            @if (pending.Count() > 0)
                                                                            {
                                                                                <span class="notification-count">@pending.Count()</span>
                                                                            }
                                                                        </a>
                                                                    </li>

                                                                    <li class="popup-task-tab">
                                                                        <a href="#"
                                                                           class="popup-tab-title active-tab"
                                                                           data-id="task-journal">
                                                                            <i class="fa-solid fa-clock"></i><span>
                                                                                Ongoing
                                                                            </span>
                                                                        </a>
                                                                    </li>

                                                                    <li class="popup-task-tab">
                                                                        <a href="/completed-tasks"
                                                                           class="popup-tab-title"
                                                                           data-id="view-mini-task">
                                                                            <i class="fa-solid fa-star"></i><span>
                                                                                Completed
                                                                            </span>
                                                                            @if (completed.Count() > 0)
                                                                            {
                                                                                <span class="notification-count">@completed.Count()</span>

                                                                            }
                                                                        </a>
                                                                    </li>
                                                                </ul>
                                                            </div>

                                                            <div class="admin-page-table-content background-panel-color">
                                                                <div class="admin-page-table-content-main">
                                                                    @*<p id="lblmsg" class="task-notice tab" style="color: white; font-size: 16px !important; display: block; background: rgb(0, 193, 171); opacity: 0.7; ">
                                                                            <span id="pop-off" style="position:relative;top:-10px;left:100%;cursor:pointer"><i class="fa-solid fa-circle-xmark"></i></span>
                                                                            @ViewBag.msg
                                                                        </p>*@
                                                                    <p id="lblmsg"></p>

                                                                    <div class="admin-page-table-content-container">

                                                                        <ul class="admin-tasks-table">

                                                                            <li class="table-row table-heading">
                                                                                <div class="table-heading-wrapper">
                                                                                    <div class="table-task-id">ID</div>
                                                                                    <div class="table-task-sla">SLA</div>
                                                                                    <div class="table-task-sla">Summary</div>
                                                                                    @*<div class="table-task-sla">Assistant</div>*@
                                                                                    <div class="table-task-status">Status</div>
                                                                                    <div class="table-task-created-by">Created by</div>
                                                                                </div>
                                                                            </li>


                                                                            @if (ongoing.Count() > 0)
                                                                            {

                                                                                foreach (var item in ongoing)
                                                                                {
                                                                                    var user = tbl_user.Where(x => x.UserID == item.FromID).FirstOrDefault();
                                                                                    var DiffInt = 6;
                                                                                    if (item.Deadline.HasValue)
                                                                                    {
                                                                                        var DeadlineDate = item.Deadline.Value.Date;
                                                                                        var currentDate = DateTime.Now.Date;
                                                                                        var diff = DeadlineDate - currentDate;
                                                                                        var daysDiff = diff.TotalDays;
                                                                                        DiffInt = (int)daysDiff;
                                                                                    }
                                                                                    <li class="table-row pagination-list">
                                                                                        <a href="/assistant-specific-task/@item.TaskID">
                                                                                            <div class="table-task-id">@i</div>

                                                                                            <div class="table-task-sla">
                                                                                                @*@if (item.Status == (int)TaskStatus.Received)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 30%;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else if (item.Status == (int)TaskStatus.Ongoing)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 60%;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else if (item.Status == (int)TaskStatus.Complete)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 100%;  "></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 100%;  "></span>
                                                                                                        </span>
                                                                                                    }*@

                                                                                                @if (item.Deadline.HasValue)
                                                                                                {
                                                                                                    if (DiffInt >= 9)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 33%; background-color: #00c1ab !important;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else if (DiffInt >= 4 && DiffInt <= 8)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 66%; background-color: #ffce00 !important;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else if (DiffInt >= 0 && DiffInt <= 3)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 90%; background-color: #e5756f !important;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 100%; background-color: #e5756f !important;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="progress-bar">
                                                                                                        <span class="progress" style="width: 33%; background-color: #00c1ab !important;"></span>
                                                                                                    </span>
                                                                                                }
                                                                                                @*@if (DiffInt >= 0 && DiffInt <= 3)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 30%;"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else if (DiffInt > 3 && DiffInt < 9)
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 60%; background-color: #ffe166 !important"></span>
                                                                                                        </span>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <span class="progress-bar">
                                                                                                            <span class="progress" style="width: 100%; background-color: #e5756f !important"></span>
                                                                                                        </span>
                                                                                                    }*@
                                                                                            </div>
                                                                                            <div class="table-task-sla">@item.TaskTitle</div>
                                                                                            <div class="table-task-status">
                                                                                                @if (item.Status == (int)TaskStatus.Received)
                                                                                                {
                                                                                                    <span class="table-task-status-data">
                                                                                                        With
                                                                                                        user
                                                                                                    </span>

                                                                                                }
                                                                                                else if (item.Status == (int)TaskStatus.Ongoing)
                                                                                                {
                                                                                                    <span class="table-task-status-data">
                                                                                                        In Progress
                                                                                                    </span>
                                                                                                }
                                                                                                else if (item.Status == (int)TaskStatus.Complete)
                                                                                                {
                                                                                                    <span class="table-task-status-data">
                                                                                                        Open
                                                                                                    </span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <span class="table-task-status-data hold">Hold</span>
                                                                                                }
                                                                                            </div>
                                                                                            <div class="table-task-created-by">@user.FirstName</div>
                                                                                        </a>
                                                                                    </li>
                                                                                    i++;
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <li class="table-row" style="text-align:center;padding:10px"> No Records Found</li>
                                                                            }


                                                                        </ul>


                                                                    </div>

                                                                    @if (ongoing.Count() > 10)
                                                                    {
                                                                        <div class="task-pagination">
                                                                            <div id="pagination"></div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </section>


    </main>
    @Html.Partial("handlerfooter")
    <script src="~/Assets/js/all.min.js"></script>
    <script src="~/Assets/js/jquery.min.js"></script>
    <script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>
    <script src="~/Scripts/jquery-3.3.1.min.js"></script>
    <script src="~/Scripts/jquery-1.6.simplePagination.min.js"></script>


    <script>

		//$(function () {
		//	$("#lblmsg").css("display", "none");

		//});
		debugger
		var msg = '@ViewBag.msg';
		if (msg == '') {
			$("#lblmsg").css("display", "none");
		}
		else {
			$("#lblmsg").append("<p class='task-notice tab' style='color: white; font-size: 16px !important; display: block; background: rgb(0, 193, 171); opacity: 0.7; '><span id='pop-off' style = 'position:relative;left:99%;cursor:pointer'><i class='fa-solid fa-circle-xmark'></i></span>" + msg + "</p>");
			$("#lblmsg").fadeOut(10000);
			msg = "";

		}
		$("#pop-off").on("click", function () {
			$("#lblmsg").css("display", "none");
		})



		$(".admin-page-sidebar-row").addClass("active__row");
		$(".handler").addClass("toggle-active");
		$(".listing").css("display","block");

		$("#ongoing").addClass("selected");

		//$(function () {
		//	pageid = 1;
		//	$(".pagination-list").hide()
		//		.slice(10 * (pageid - 1),
		//			10 + 10 * (pageid - 1)).show();
		//});
		$(".pagination-list").slice(10).hide();
		$('#pagination').pagination({
			// Total number of items present
			// in wrapper class
			//items: 9,
			items: '@ongoing.Count()',
			// Items allowed on a single page
			itemsOnPage: 10,
			onPageClick: function (pageid) {
				$(".pagination-list").hide()
					.slice(10 * (pageid - 1),
						10 + 10 * (pageid - 1)).show();
				//$("#list").load("/Handlers/task_list", { id: pageid });

			}
		});
    </script>


</body>

</html>