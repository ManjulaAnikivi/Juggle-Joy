@model juggle_joy.Models.AssistantChangePasswordValidation
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>

    <link rel="stylesheet" href="~/Assets/css/dashboard.css">
    @Html.Partial("assistantHandler_css")
    @*<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>*@
    @*<script src="~/Assets/js/admin-dashboard.js"></script>*@
</head>

<body class="body-change-password-page">
	@Html.Partial("assistantheader")
	<main class="main change-password-page">
		<div class="dashboard-background">

			<section class="change-password my-profile">
				<div class="change-password-main my-profile-main">
					<div class="container">
						<div class="content-wrapper">
							<div class="row">
								@Html.Partial("asstsidebar")

								<div class="col-xl-9 col-lg-9 col-md-12 col-12 main-content">

									<h2>
										Change Password
									</h2>
									<p id="lbl-msg" style="color: #00c1ab">@ViewBag.msg</p>
									@using (Html.BeginForm("assistant_changepassword", "Assistants", FormMethod.Post, new { @id = "profile_form", @name = "profile_form" }))
									{
										<fieldset>
											<div class="half-fields">
												<div class="form_field">
													<label for="profile_old_password">Old Password*</label>
													@Html.PasswordFor(x => x.OldPassword, new { @placeholder = "Enter your old password" })
													@Html.ValidationMessageFor(x => x.OldPassword, "", new { @class = "text-danger" })

												</div>
												<div class="form_field">
													<label for="profile_new_password">New Password*</label>
													@Html.PasswordFor(x => x.NewPassword, new { @placeholder = "Enter your new password" })
													@Html.ValidationMessageFor(x => x.NewPassword, "", new { @class = "text-danger" })
												</div>
											</div>

											<div class="half-fields single-field">
												<div class="form_field">
													<label for="profile_confirm_new_password">
														Confirm New
														Password*
													</label>
													@Html.PasswordFor(x => x.ConfirmNewPassword, new { @placeholder = "Confirm new password" })
													@Html.ValidationMessageFor(x => x.ConfirmNewPassword, "", new { @class = "text-danger" })
												</div>
											</div>

											<div class="form_submit">
												<input type="submit" value="Save">
												<button type="button" class="cancel-btn">Cancel</button>
											</div>
										</fieldset>
									}

								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

		</div>
	</main>


	@Html.Partial("handlerfooter")

	@Html.Partial("js")

	<script>
		if ('@ViewBag.msg' == null) {
			$("#lbl-msg").fadeOut();
		}
		else {
			$("#lbl-msg").fadeOut(5000);
		}
		$("#change_pass").addClass("active");


		$(".cancel-btn").on("click", function () {
			window.location.href = "/assistant-change-password";
		})
	</script>
</body>

</html>
<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>
