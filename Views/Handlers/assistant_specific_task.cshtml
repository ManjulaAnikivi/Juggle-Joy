    <script>

        $('#upload').submit(function (e) {
            debugger
            $(".show").text("");
            $(".hide").show();
            e.preventDefault(); // stop the standard form submission
            var label = $("#lblMessage");
            var filePath = $("#fileattachment")[0].value;
          /*  alert(filePath);*/
            label.text("");
            var extension = filePath.substring(filePath.lastIndexOf(".") + 1, filePath.length).toLowerCase();
            var validFilesTypes = ["pdf", "doc", "docx"];
            var isValidFile = validFilesTypes.includes(extension);
            if (filePath == "") {
                label.html("Please upload file");
                return false;
            }
            else if (!isValidFile) {
                label.html("Invalid File. Please upload file with extension: " + validFilesTypes.join(", ") + ".");
                return false;
            } else {
                 var data = new FormData(this);
                 data.append('taskid',@Model.TaskID);
                 @*data.append('userid',@Model.ToID);*@
                 debugger
                 $.ajax({
                     url: "/Handlers/fileupload",
                     type: "Post",
                     //data: new FormData(this),
                     data: data,
                     cache: false,
                     contentType: false,
                     processData: false,
                     cache:false,
                     success: function (data) {
                         if (data.filecount) {
                             label.html("Maximum 6 files can be uploaded");
                             setTimeout(function () {
                                 label.text("");
                             }, 3000);
                             $('#upload')[0].reset();
                             return false;
                         }
                         else if (data.filesize) {
                             label.html("Total file size exceeds the maximum limit of 30MB.");
                             setTimeout(function () {
                                 label.text("");
                             }, 3000);
                             $('#upload')[0].reset();
                             return false;
                         }
                         else {
                             //var obj = $.parseJSON(data);
                             //var taskid = obj.TaskID;
                             //$("#loadfiles").load("/Handlers/loadfilelist", { id: obj.TaskAttachmentID });
                             var taskid = data.taskid;
                             $("#filelist").load("/Handlers/loadfiles", { id: taskid },
                                 function () {
                                     //alert("File uploaded successfully");
                                     $("#lbl_Message").text("File uploaded successfully");
                                     setTimeout(function () {
                                         $("#lbl_Message").text("");
                                 }, 3000);

                                 });

                                   $(".task-events-main").load("/task/log_Events", { id:taskid});
                                 //Clear the file input feild
                             $('#upload')[0].reset();

                         }


                     },
                     error: function (xhr, error, status) {
                         console.log(error, status);
                     }
                 });
            }

        });

        function deletefiles(id) {
            debugger
            var label = $("#lblMessage");
            label.text("");

            var res = confirm("Are you sure want to delete the file");
            if (res == true) {
                $.ajax({
                    url: "/Handlers/deletefile",
                    type: "Post",
                    data: { id: id},
                    dataType: "json",
                    success: function (data) {
                        if (data.notvaliduser) {
                            label.text("You can't delete the file since it is not uploaded by you.");
                            setTimeout(function () {
                                label.text("");
                            }, 3000);
                        } else {
                            //alert(data.taskid);
                            var taskid = data.taskid;

                            $("#filelist").load("/Handlers/loadfiles", { id: taskid },
                                function () {
                                    //alert("File uploaded successfully");
                                    label.text("File is deleted successfully");
                                    setTimeout(function () {
                                        label.text("");
                                    }, 3000);

                                });

                            $(".task-events-main").load("/task/log_Events", { id: taskid });
                        }



                    },
                    error: function (xhr, error, status) {
                        console.log(error, status);
                    }
                });
            }

        }


