<body class="body-assistant-specific-task-page body-admin-pages">
    @Html.Partial("handlerheader")
    <main class="main assistant-specific-task-page">
        <section class="admin-handler-dashboard-section">
            <div class="admin-handler-dashboard-main">
                <div class="container-fluid">
                    <div class="grid admin-page-grid">
                        <div class="admin-page-sidebar">
                            <div class="admin-page-sidebar-main">
                                <div class="admin-page-sidebar-row">
                                    <h3 class="handler">@hanlderName.FirstName</h3>
                                    <ul class="listing">

                                        @foreach (var item in handler)
                                        {
                                            var assistants = ctx.tbl_user.Where(x => x.UserID == item.UserID && x.UserType == "A" && x.Status == (int)UserStatus.Active).ToList();
                                            foreach (var items in assistants)
                                            {
                                                var pendingTask = ctx.tbl_task.Where(x => x.AssistantID == items.UserID && x.Status == (int)TaskStatus.Received).ToList().Count();
                                                if (items.UserID == Model.AssistantID)
                                                {
                                                    <li class="selected">
                                                        <a href="/Handlers/task_pending/@item.UserID">@items.FirstName</a>
                                                        @if (pendingTask > 0)
                                                        {
                                                            <span class="sidebar-notification-count">

                                                                @pendingTask
                                                            </span>
                                                        }

                                                    </li>
                                                }
                                                else
                                                {
                                                    <li class="">
                                                        <a href="/Handlers/task_pending/@item.UserID">@items.FirstName</a>
                                                        @if (pendingTask > 0)
                                                        {
                                                            <span class="sidebar-notification-count">
                                                                @pendingTask
                                                            </span>
                                                        }
                                                    </li>
                                                }

                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>


                        <div class="admin-page-task-content background-panel-color">
                            <div class="admin-page-task-content-main">
                                <div class="form_submit" style="text-align:right;margin-bottom:10px">
                                    <button type="submit" value="Go back" onclick="" class="bttn" id="reloadBackButton"><i class="fa fa-arrow-left" aria-hidden="true" style="font-size:26px"></i></button>
                                </div>
                                <div class="admin-page-task-content-container">

                                    <div class="dashboard-popup-content dashboard-popups dashboard-popup-background">
                                        <section class="task-detail-popup message-handler">
                                            <div class="task-detail-popup-main">
                                                <div class="popup-container">
                                                    <div class="task-detail-popup-wrapper">
                                                        <div class="content-wrapper">

                                                            <div class="task-popup-box-contents">
                                                                <div class="row">

                                                                    <div class="col-lg-9 col-md-8 col-12 tab-content">
                                                                        <div class="popup-tabs">

                                                                            <div class="popup-task-tab-titles">
                                                                                <ul>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title active-tab"
                                                                                           data-id="task-details">
                                                                                            <i class="fa-solid fa-comment-dots"></i><span>
                                                                                                Task
                                                                                                Details
                                                                                            </span>
                                                                                            <!-- <span
                                                                                            class="notification-count">3</span> -->
                                                                                        </a>
                                                                                    </li>
                                                                                    @if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Complete)
                                                                                    {
                                                                                        <li class="popup-task-tab">
                                                                                            <a href="javascript:void(0)"
                                                                                               class="popup-tab-title"
                                                                                               data-id="task-journal">
                                                                                                <i class="fa-solid fa-pen-to-square"></i><span>
                                                                                                    Messenger
                                                                                                </span>
                                                                                            </a>
                                                                                        </li>
                                                                                        @*<li class="popup-task-tab">
                                                                                                <a href="javascript:void(0)"
                                                                                                   class="popup-tab-title"
                                                                                                   data-id="message-handler">
                                                                                                    <i class="fa-solid fa-comment-dots"></i><span>
                                                                                                        Chat
                                                                                                    </span><span class="notification-count" id="chatcount"></span>
                                                                                                </a>
                                                                                            </li>*@
                                                                                    }
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="view-mini-task">
                                                                                            <i class="fa-solid fa-eye"></i><span>
                                                                                                Mini-task
                                                                                            </span>
                                                                                        </a>
                                                                                    </li>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="attachment">
                                                                                            <i class="fa-solid fa-paperclip"></i><span>Attachment</span>
                                                                                        </a>
                                                                                    </li>
                                                                                    <li class="popup-task-tab">
                                                                                        <a href="javascript:void(0)"
                                                                                           class="popup-tab-title"
                                                                                           data-id="task-events">
                                                                                            <i class="fa-solid fa-calendar-days"></i><span>
                                                                                                Events
                                                                                            </span>
                                                                                        </a>
                                                                                    </li>
                                                                                </ul>
                                                                            </div>

                                                                            <div class="popup-tabs-container">

                                                                                <div class="popup-tabs-section tab-active"
                                                                                     data-id="task-details">

                                                                                    <div class="task-popup-content task-content">
                                                                                        <div class="task-popup-content-left task-left">
                                                                                            <div class="task-icon-wrapper">
                                                                                                <div class="task-icon">
                                                                                                    <img src="~/Assets/Category/@tblcat.CategoryImage"
                                                                                                         alt="task-cake">
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="popup-task-title">
                                                                                                <h2>
                                                                                                    @Model.TaskTitle
                                                                                                </h2>
                                                                                                <div class="popup-task-title-bottom">
                                                                                                    <p class="task-bottom-info">
                                                                                                        <span class="strong-heading">
                                                                                                            Task
                                                                                                            in
                                                                                                            progress:
                                                                                                        </span>
                                                                                                        @if (Model.AssistantID != null)
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                With
                                                                                                                your
                                                                                                                assistant,
                                                                                                                @assist_name.FirstName @assist_name.LastName
                                                                                                            </span>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                Assistant not assigned
                                                                                                            </span>
                                                                                                        }

                                                                                                    </p>

                                                                                                    <p class="task-bottom-info">
                                                                                                        <span class="strong-heading">
                                                                                                            Due
                                                                                                            Date:
                                                                                                        </span>
                                                                                                        @if (@Model.Deadline.HasValue)
                                                                                                        {
                                                                                                            if (DiffInt > 0)
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    @Model.Deadline.Value.ToString("dd MMM yy") (in  @daysDiffInt
                                                                                                                    days)
                                                                                                                </span>

                                                                                                            }
                                                                                                            else if (DiffInt == 0)
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    @Model.Deadline.Value.ToString("dd MMM yy") (Expiring today)
                                                                                                                </span>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <span class="text-content">
                                                                                                                    Expired
                                                                                                                </span>
                                                                                                            }

                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="text-content">
                                                                                                                No Due Date
                                                                                                            </span>
                                                                                                        }


                                                                                                    </p>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="box-content">
                                                                                        @if (Model.Status == (int)TaskStatus.Ongoing || Model.Status == (int)TaskStatus.Complete)
                                                                                        {
                                                                                            <div class="popup-task-review-box box-background">
                                                                                                @*<span class="task-status-status task-status status-action-required"></span>*@
                                                                                                <div class="popup-task-review-wrapper">
                                                                                                    <h4>Recommendations</h4>
                                                                                                    <div class="popup-task-reviws">

                                                                                                        @if (recommendation.Count() > 0)
                                                                                                        {
                                                                                                            foreach (var item in recommendation)
                                                                                                            {

                                                                                                                <div class="task-review">
                                                                                                                    @if (item.TaskStatus == 1)
                                                                                                                    {
                                                                                                                        @*<span class="icon-container">
                                                                                                                                <i class="fa fa-check selectedopt" aria-hidden="true" title="selected by user"></i>
                                                                                                                            </span>*@
                                                                                                                        <a data-title="selected by user"> <i class="fa fa-check selectedopt" aria-hidden="true"></i></a>
                                                                                                                    }
                                                                                                                    <span class="strong-heading">
                                                                                                                        Option @j :
                                                                                                                    </span>
                                                                                                                    <span class="text-content">
                                                                                                                        @item.Name
                                                                                                                    </span>
                                                                                                                    <a href="javascript:void(0)"
                                                                                                                       class="task-review-btn">
                                                                                                                        <i class="fa-solid fa-chevron-right"></i>
                                                                                                                    </a>
                                                                                                                    <div class="task-review-box-details">
                                                                                                                        @*Lorem ipsum dolor sit amet, consectetur adipisicing elit. Accusantium explicabo officia ad laboriosam quos rem.*@
                                                                                                                        <div class="rev-acc-inn-hd">
                                                                                                                            <div class="meta-data">
                                                                                                                                <h6 class="title">@item.Name</h6>
                                                                                                                                <div class="rating">
                                                                                                                                    <span class="rat-list" style="color: #ffb065 !important">
                                                                                                                                        <i class="fa fa-star" aria-hidden="true"></i>
                                                                                                                                        <i class="fa fa-star" aria-hidden="true"></i>
                                                                                                                                        <i class="fa fa-star" aria-hidden="true"></i>
                                                                                                                                        <i class="far fa-star" aria-hidden="true"></i>
                                                                                                                                        <i class="far fa-star" aria-hidden="true"></i>
                                                                                                                                    </span>
                                                                                                                                    <span class="rat-label">26 reviews / 8.5</span>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                        </div>
                                                                                                                        <p>@item.Note</p>
                                                                                                                        <div class="props-wrapper row">
                                                                                                                            <div class="item col-md-6 col-12">
                                                                                                                                <div class="label">Price</div>
                                                                                                                                <div class="value">@item.Price</div>
