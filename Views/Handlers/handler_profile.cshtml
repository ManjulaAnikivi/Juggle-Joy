@model juggle_joy.Models.HandlerProfileValidation
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@MvcApplication.project_name</title>

    <link rel="stylesheet" href="~/Assets/css/dashboard.css">
    @Html.Partial("assistantHandler_css")

    @*<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>*@
    @*<script src="~/Assets/js/admin-dashboard.js"></script>*@
</head>

<body class="body-my-profile-page">
	@Html.Partial("handlerheader")

	<main class="main my-profile-page">
		<div class="dashboard-background">

			<section class="my-profile">
				<div class="my-profile-main">
					<div class="container">
						<div class="content-wrapper">
							<div class="row">
								@Html.Partial("handlersidebar")

								<div class="col-xl-9 col-lg-9 col-md-12 col-12 main-content">

									<h2>
										My Profile
									</h2>
									<p id="lbl_msg" style="color: #00c1ab">@ViewBag.msg</p>
									@using (Html.BeginForm("handler_profile", "Handlers", FormMethod.Post, new { @id = "profile_form", @name = "profile_form" }))
									{
										<fieldset>
											<div class="half-fields">
												<div class="form_field">
													<label for="FirstName">First Name*</label>
													@Html.TextBoxFor(x => x.FirstName, "", new { @placeholder = "First Name" })
													@Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })

												</div>
												<div class="form_field">
													<label for="LastName">Last Name*</label>
													@Html.TextBoxFor(x => x.LastName, "", new { placeholder = "Last Name" })
													@Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
												</div>
											</div>

											<div class="half-fields">
												<div class="form_field">
													<label for="PhoneNo">Mobile No*</label>
													@Html.TextBoxFor(x => x.PhoneNo, "", new { @placeholder = "+12 34567 89000", @pattern = "[0-9]{3}-[0-9]{2}-[0-9]{3}]" })
												</div>
												<div class="form_field">
													<label for="EmailID">Email ID</label>
													@Html.TextBoxFor(x => x.EmailID, "", new { placeholder = "annawilliams@gmail.com", @readonly = "readonly", @style = "opacity:0.6" })
													@*@Html.ValidationMessageFor(x => x.EmailID, "", new { @class = "text-danger" })*@

												</div>
											</div>
											<div class="form_submit">
												<input type="submit" value="Save">
												<button type="button" class="cancel-btn">Cancel</button>
											</div>
										</fieldset>
									}

								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

		</div>
	</main>

	@Html.Partial("handlerfooter")

	@Html.Partial("js")

	<script>

		if ('@ViewBag.msg' == null) {
			$("#lbl_msg").fadeOut();
		}
		else {
			$("#lbl_msg").fadeOut(5000);

		}

		$("#profile").addClass("active");
		$(".cancel-btn").on("click", function () {
			window.location.href = "/handler-profile";
		})
	</script>

	<script src="~/Assets/js/jquery.custom.selectbox.min.js"></script>


</body>

</html>