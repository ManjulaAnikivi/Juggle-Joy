@model juggle_joy.Models.PriceValidation
    @using juggle_joy.Models
@{
    ViewBag.Title = "Registration  price | " + MvcApplication.project_name;
    
}
<style>
    #register-tab-2 {
        border-bottom-color: #227495
    }

    .form-box {
        max-width: 700px;
        border: var(--gray-color) 1px solid;
    }

    .pt-2 {
        padding-top: 0.5rem !important;
    }
</style>
<ul class="breadcrumb">
    <li><a href="~/admin/dashboard">Home</a></li>
    <li class="active">Price</li>
</ul>
<div class="page-title">
        <h2><span class="fa fa-gbp"></span> Registration  price </h2>
</div>

<div class="page-content-wrap">
    <div class="row">
        <div class="col-xs-12  col-md-12 col-lg-12">
            @using (Html.BeginForm("addPrice", "price", FormMethod.Post))
            {
                @Html.HiddenFor(x => x.PriceID);
                @Html.AntiForgeryToken();
                <div class="panel panel-default">
                    <p id="lbl_msg" class="panel-title msg">@ViewBag.PriceMsg</p>
                    <div class="panel-body">
                        <div class="row">
                            <div class="row">
                                <div class="form-group col-md-6">
                                    <label for="FirstName" class="control-label">Actual Price<span class="req"> *</span></label>
                                    @Html.TextBoxFor(x => x.ActualPrice, new { @class = "form-control"})
                                    @Html.ValidationMessageFor(x => x.ActualPrice)
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="LastName" class="control-label">Discounted Price<span class="req"> *</span></label>
                                    @Html.TextBoxFor(x => x.DiscountedPrice, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.DiscountedPrice)
                                </div>
                                
                            </div>
                           
                          
                        </div>
                        <div class="panel-footer">
                                <button type="submit" class="btn btn-primary pull-right">Update Price</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script>
    $('#lnk_price').addClass("active");
        if ('@ViewBag.PriceMsg' != "")
        {
            $("#lbl_msg").fadeOut(10000);
        }
        else
        {
            $("#lbl_msg").fadeOut();
        }
        $('#cancel').click(function () {
            window.location.href = "/price/addPrice";
        });
</script>

