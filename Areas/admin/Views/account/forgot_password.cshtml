@model juggle_joy.Models.ForgotPasswordValidation
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" style="background:white;">
<head>
	<title>Forgot Password | @MvcApplication.project_name</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<link rel="shortcut icon" href="~/Assets/images/logo-100x100.png" type="image/x-icon" />
	<link href="~/admin_assets/css/Adminlte/AdminLTE.min.css" rel="stylesheet" />
	<link href="~/admin_assets/css/theme-default.css" rel="stylesheet" type="text/css" id="theme" />
	<link href="~/admin_assets/css/login.min.css" rel="stylesheet" />
	<link href="~/admin_assets/css/UnabtrusiveValidation.css" rel="stylesheet" />
	<script src="~/admin_assets/js/jquery-1.9.1.min.js"></script>
	<script src="~/admin_assets/js/jquery.validate.min.js"></script>
	<script src="~/admin_assets/js/jquery.validate.unobtrusive.min.js"></script>
</head>
<body class="login-page login-page-bg">
    <div class="container">
        <div class="row">
            <div class="col-md-12"><a href="/admin"><img src="~/assets/images/logo.png" alt="juggle-joy Logo" class="login-page-logo" /></a></div>
            @*<div class="col-md-12"><h1 class="text-bold">ATW</h1></div>*@
        </div>
        <hr />
    </div>
    <div class="login-box login-box-border">
        <div class="login-box-body">
            <div class="login-logo">Forgot Password</div>
            <p class="login-box-msg">@ViewBag.msg</p>
            @using (Html.BeginForm("forgot_password", "account", new { RetUrl = ViewBag.Returl }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group has-feedback">
                    @Html.TextBoxFor(x => x.emailid, new { @class = "form-control", placeholder = "Email ID", maxlength = "75" })
                    <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                    @Html.ValidationMessageFor(x => x.emailid)
                </div>
                <div class="row">
                    <div class="col-xs-6 login-box-footer">
                        <input type="hidden" name="RetUrl" value='@ViewBag.RetUrl' />
                        <button id="btnsubmit" type="submit" class="btn btn-info btn-block btn-flat" style="margin-left:-8px">
                            Get Password
                        </button>
                    </div>
                    <div class="col-xs-6 pull-right text-right">
                        <a href="/admin/account/login">Back to Log In</a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="container forgotpwd-footer">
        <hr />
        <div class="row">
            <div class="col-md-12 text-center">
                <span>Copyright &copy; @DateTime.Now.Year Juggle Joy | All Rights Reserved | <span class="dlink">By: <a href="http://www.aalpha.net/" target="_blank">Aalpha</a></span></span>
            </div>
        </div>
    </div>

</body>
</html>