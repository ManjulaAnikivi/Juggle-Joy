                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3 col-lg-3">
            <div class="widget widget-success widget-item-icon" style="cursor: pointer; background: #3f51b5" onclick="javascript: location.href = '/admin/contacts'">
                <div class="widget-item-left">
                    <span class="fa fa-phone"></span>
                </div>
                <div class="widget-data">
                    <div class="widget-int num-count">@contacts</div>
                    <div class="widget-title">Contacts Received</div>
                    <div class="widget-subtitle">View contact details</div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3 col-lg-3">
            <div class="widget widget-success widget-item-icon" style="cursor: pointer; background: #2196f3" onclick="javascript: location.href = '/admin/subscribers'">
