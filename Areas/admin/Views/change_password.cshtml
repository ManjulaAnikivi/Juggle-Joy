
@model juggle_joy.Models.ChangePasswordValidation
@{
	ViewBag.Title = "Change Password | " + MvcApplication.project_name;
}

<ul class="breadcrumb">
	<li><a href="~/admin/dashboard">Home</a></li>
	<li class="active">Change Password</li>
</ul>
<div class="page-title">
	<h2><span class="fa fa-lock"></span> Change Password</h2>
</div>
<div class="row">
	<div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
		@using (Html.BeginForm("change_password", "account", FormMethod.Post))
		{
			<div class="panel panel-default">
				<p id="lbl_msg" class="panel-title msg">@ViewBag.msg</p>
				<div class="panel-body">
					<div class="form-group">
						<label for="OldPassword" class="control-label">Old Password<span class="req"> *</span></label>
						@Html.PasswordFor(x => x.OldPassword, new { @class = "form-control" })
						@Html.ValidationMessageFor(x => x.OldPassword)
					</div>
					<div class="form-group">
						<label for="NewPassword" class="control-label">New Password<span class="req"> *</span></label>
						@Html.PasswordFor(x => x.NewPassword, new { @class = "form-control" })
						@Html.ValidationMessageFor(x => x.NewPassword)
					</div>
					<div class="form-group">
						<label for="ConfirmNewPassword" class="control-label">Confirm Password<span class="req"> *</span></label>
						@Html.PasswordFor(x => x.ConfirmNewPassword, new { @class = "form-control" })
						@Html.ValidationMessageFor(x => x.ConfirmNewPassword)
					</div>
				</div>
				<div class="panel-footer">
					@*<a href="change-password" class="btn btn-default">Clear Form</a>*@
					<button type="submit" class="btn btn-primary pull-right">Change Password</button>
				</div>
			</div>
		}
	</div>
</div>

<script type="text/javascript">
	$('#lnk_setting,#lnk_change_pwd').addClass("active");

    if ('@ViewBag.msg' != "") {
        $("#lbl_msg").fadeOut(5000);
    }
    else {
        $("#lbl_msg").fadeOut();
    }
</script>

