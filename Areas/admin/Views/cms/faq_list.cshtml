                var section = $(this).attr("id");
                faqlist = faqlist + "," + $(this).attr("id");
            })
            //faqlist.trim(',');
            //alert(faqlist);
            $.ajax
                ({
                    type: "post",
                    url: "/admin/cms/update_preference",
                    data: { faqlist: faqlist },
                    dataType: "json",
                    success: function (data) {
                        if (data == true) {

                        }
                        else {

                        }
                    }
                });
        }
    });

</script>