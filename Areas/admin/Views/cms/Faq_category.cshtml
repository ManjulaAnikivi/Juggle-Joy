@model juggle_joy.Models.Faq_CategoryValidation
@{
	ViewBag.Title = "FAQ-Category | " + MvcApplication.project_name;
}
<style>
	body {
		overflow: unset !important;
		background: #f5f5f5 !important;
	}
</style>

<ul class="breadcrumb">
	<li><a href="~/admin/account/dashboard">Home</a></li>
	<li class="active">Faq-Category</li>
</ul>

<div class="page-title">

	@if (Model.Faq_Cat_id > 0)
	{
		<h2><span class="fa fa-sitemap"></span> Update Faq Category</h2>
	}
	else
	{
		<h2><span class="fa fa-sitemap"></span> Add Faq Category</h2>
	}
</div>

<div class="page-content-wrap">
	<div class="row">
		<div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">

			@using (Html.BeginForm("Faq_category", "cms", FormMethod.Post))
			{
				@Html.AntiForgeryToken();
				@Html.HiddenFor(x => x.Faq_Cat_id)
				<div class="panel panel-default">
					<p id="lbl_msg" class="panel-title msg">@ViewBag.catmsg</p>

					<div class="panel-body">


						<div class="row">
							<div class=" col-md-10 ">
								<div class="form-group">
									<label for="Category" class="control-label">Category Name</label>
									@Html.TextBoxFor(x => x.Category, new { @class = "form-control flat", maxlength = "50" })
									@Html.ValidationMessageFor(x => x.Category)
								</div>
							</div>
						</div>
						<br />

					</div>
					<div class="panel-footer">


						@if (Model.Faq_Cat_id == 0)
						{
							<input type="submit" id="btnaddcategory" class="btn btn-primary pull-right" value="Add Category" />
						}
						else
						{
							<input type="submit" id="btnupdate" class="btn btn-primary pull-right" value="Update Category" />
							<input type="button" id="cancelcategory" class="btn btn-default" value="Cancel" />
						}

					</div>
				</div>
			}
		</div>
	</div>

	<div class="row" id="list">

	</div>

</div>

<script type="text/javascript">

	$('#faq-cat,#lnk_manage_faq').addClass("active");

            if ('@ViewBag.catmsg' != "") {
                $("#lbl_msg").fadeOut(10000);
            }
           else {
                $("#lbl_msg").fadeOut();
            }



            $(document).ready(function () {
				$('#list').load("/admin/cms/Faq_categortlist", { id: 0 })
            });

            $('#cancelcategory').click(function () {
				window.location.href = "/admin/manage-Faq-category";
            });

</script>