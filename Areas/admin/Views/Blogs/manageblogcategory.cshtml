@model juggle_joy.Models.BlogCategoryValidation
@{
    ViewBag.Title = "Blog Category | " + MvcApplication.project_name;
}
<style>
    body {
        overflow: unset !important;
        background: #f5f5f5 !important;
    }
</style>

<ul class="breadcrumb">
    <li><a href="~/admin/account/dashboard">Home</a></li>
    <li class="active">Blog Category</li>
</ul>

<div class="page-title">

    @if (Model.CategoryID > 0)
    {
        <h2><span class="fa fa-sitemap"></span> Update Blog Category</h2>
    }
    else
    {
<h2><span class="fa fa-sitemap"></span> Add Blog Category</h2>
    }
</div>

<div class="page-content-wrap">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6">

            @using (Html.BeginForm("manageblogcategory", "Blogs", FormMethod.Post))
            {
                @Html.AntiForgeryToken();
                @Html.HiddenFor(x => x.CategoryID)
                <div class="panel panel-default">
                    <p id="lbl_msg" class="panel-title msg">@ViewBag.blogcatmsg</p>

                    <div class="panel-body">


                        <div class="row">
                            <div class=" col-md-10 ">
                                <div class="form-group">
                                    <label for="Category" class="control-label">Category Name</label>
                                    @Html.TextBoxFor(x => x.Category, new { @class = "form-control flat", maxlength = "50" })
                                    @Html.ValidationMessageFor(x => x.Category)
                                </div>
                            </div>
                        </div>
                        <br />

                    </div>
                    <div class="panel-footer">


                        @if (Model.CategoryID == 0)
                        {
                            <input type="submit" id="btnaddcategory" class="btn btn-primary pull-right" value="Add Blog Category" />
                        }
                        else
                        {
                            <input type="submit" id="btnupdate" class="btn btn-primary pull-right" value="Update Blog Category" />
                            <input type="button" id="cancelcategory" class="btn btn-default" value="Cancel" />
                        }

                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row" id="list">

    </div>

</div>

<script type="text/javascript">

    $('#lnk_manage_Blogs,#blog_category').addClass("active");

            if ('@ViewBag.blogcatmsg' != "") {
                $("#lbl_msg").fadeOut(10000);
            }
           else {
                $("#lbl_msg").fadeOut();
            }



            $(document).ready(function () {
                $('#list').load("/admin/manage-blogcategory", { id: 0 })
            });

            $('#cancelcategory').click(function () {
                window.location.href = "/admin/add-blogcategory";
            });

</script>