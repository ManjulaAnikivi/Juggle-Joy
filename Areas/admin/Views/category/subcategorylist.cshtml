@model IEnumerable<juggle_joy.Models.tbl_subcategory>
@using juggle_joy.Models;
@{
    Layout = null;
}
<style>
    .switch span {
        width: 44px;
        height: 20px;
        border-radius: 0px;
    }

        .switch span:after {
            width: 20px;
            border-radius: 0px;
        }

    .list-group .list-group-item {
        height: 48px;
    }
</style>

<div class="page-title">
    <h2><span class="fa fa-edit"></span> List of Subcategories</h2>
</div>



<div class="page-content-wrap">
    <div class="row">
        <div class="col-xs-12 col-md-10 col-lg-10">
            
                @using (Html.BeginForm("deletesubCat", "category", FormMethod.Post))
                {


        <div class="panel panel-default">
            <p id="lblmsg" class="panel-title msg">@ViewBag.subcaterror</p>

            <div class="panel-body table-responsive">
                @if (Model.Count() > 0)
                {

                    <table id="tblSubCatList" class="table dataTable table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="background-position:center left;">Category</th>
                                <th style="background-position:center left;">Sub Category</th>
                                <th style="background-position:center left;">Edit</th>
                                <th style="background-image:none;text-align:center" align="center"><input type="checkbox" id="chkall" style="margin-left: 8px;" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.tbl_category.Category</td>
                                    <td>@item.SubCategory</td>
                                    <td><a href="~/admin/add-subcategory/@item.SubCategoryID"><i class="fa fa-edit"></i></a></td>
                                    <td align="center"><input type="checkbox" name="IdsToDelete" value='@item.SubCategoryID' onclick="check()" style="margin-left: 6px;" /></td>
                                </tr>
                            }

                        </tbody>

                        <tr>
                            <td align="right" colspan="4" style="padding-right:10px;">
                                <input type="submit" id="btndelete" value="Delete" class="btn btn-danger" />
                            </td>
                        </tr>
                    </table>

                }

                else
                {
                <table width="90%" border="0" align="center" cellpadding="3" cellspacing="3">
                    <tr>
                        <td>
                            <div style="color: #e80c4d">
                                No records found
                            </div>
                        </td>
                    </tr>
                </table>
                }

            </div>
        </div>
                }
        </div>
    </div>
</div>
<script type="text/javascript" >

     if ('@ViewBag.subcaterror' != "") {
            //window.scrollTo(0, 500);
            $("#lblmsg").fadeOut(10000);
            }
           else {
            $("#lblmsg").fadeOut();
            }
    $(document).ready(function (e) {
        $('#btndelete').click(function () {
            if ($("input[name='IdsToDelete']:checked").length == 0) {
                alert("Please select record to delete.");
                return false;
            }
            else {
                var count = $("input[name='IdsToDelete']:checked").length;
                return confirm("Are you sure want to delete " + count + " record(s).");
            }
        });
    });
    $("#chkall").change(function () {
        $("input[name='IdsToDelete']").prop('checked', $(this).prop("checked"));
    });
    $("input[name='IdsToDelete']").change(function () {
        if (false == $(this).prop("checked")) {
            $("#chkall").prop('checked', false);
        }
        if ($("input[name='IdsToDelete']:checked").length == $("input[name='IdsToDelete']").length) {
            $("#chkall").prop('checked', true);
        }
    });
</script>

<script type="text/javascript" defer>
    $(document).ready(function (e) {
        $('#tblSubCatList').DataTable({
            "aoColumns": [{ "bSearchable": true }, { "bSearchable": true }, { "bSearchable": false }, { "bSearchable": false }],
            "paging": true,
            "searching": true,
            "lengthChange": true,
            "iDisplayLength": 10,
            "info": true,
            "autoWidth": true,
            "stateSave": true,
            "ordering": false,
        });
        //$('#lnk_equip').addClass("active");
        //$('#manage_equip').addClass("active");
    });
</script>

